diff --git a/app/lib/models/selection_prepayment_estimate.dart b/app/lib/models/selection_prepayment_estimate.dart
new file mode 100644
--- /dev/null
+++ b/app/lib/models/selection_prepayment_estimate.dart
@@ -0,0 +1,163 @@
+import 'selection_terms_estimate.dart';
+
+/// A zero-advance source plus a server-calculated requested advance delta.
+/// Source conditions remain distinct from requested/provider finance terms.
+class SelectionPrepaymentEstimate {
+  static const version = 'selection_prepayment_estimate_v1';
+  static const policyVersion = 'zero_prepayment_delta_v1';
+
+  const SelectionPrepaymentEstimate._({
+    required this.monthlyPayment,
+    required this.sourceRevision,
+    required this.sourceRecordId,
+    required this.referenceVehicleTrimId,
+    required this.selectionFingerprint,
+    required this.termMonths,
+    required this.annualKm,
+    required this.requestedPrepaymentAmount,
+    required this.requestedPrepaymentPct,
+  });
+
+  final int monthlyPayment;
+  final String sourceRevision;
+  final String sourceRecordId;
+  final String referenceVehicleTrimId;
+  final String selectionFingerprint;
+  final int termMonths;
+  final int annualKm;
+  final int requestedPrepaymentAmount;
+  final double requestedPrepaymentPct;
+
+  static SelectionPrepaymentEstimate? tryParse(Object? raw) {
+    if (raw is! Map ||
+        !SelectionTermsEstimate.hasExactStrings(raw.keys.toList(), const [
+          'version',
+          'verified',
+          'policy_version',
+          'quote_kind',
+          'product_type',
+          'monthly_payment',
+          'source_revision',
+          'source_record_id',
+          'reference_vehicle_trim_id',
+          'selection_fingerprint',
+          'source_conditions',
+          'source_prepayment_amount',
+          'requested_prepayment_amount',
+          'requested_prepayment_pct',
+          'unverified_conditions',
+        ]) ||
+        raw['version'] != version ||
+        raw['verified'] != true ||
+        raw['policy_version'] != policyVersion ||
+        raw['quote_kind'] != 'ESTIMATE' ||
+        raw['product_type'] != 'RENTAL' ||
+        raw['monthly_payment'] is! int ||
+        (raw['monthly_payment'] as int) <= 0 ||
+        (raw['monthly_payment'] as int) > 10000000 ||
+        raw['source_revision'] is! String ||
+        !RegExp(
+          r'^sha256:[0-9a-f]{64}$',
+        ).hasMatch(raw['source_revision'] as String) ||
+        ![raw['source_record_id'], raw['reference_vehicle_trim_id']].every(
+          (value) =>
+              value is String && value.isNotEmpty && value.trim() == value,
+        ) ||
+        raw['selection_fingerprint'] is! String ||
+        !RegExp(
+          r'^[0-9a-f]{64}$',
+        ).hasMatch(raw['selection_fingerprint'] as String) ||
+        raw['source_prepayment_amount'] is! int ||
+        raw['source_prepayment_amount'] != 0 ||
+        raw['requested_prepayment_amount'] is! int ||
+        (raw['requested_prepayment_amount'] as int) <= 0 ||
+        raw['requested_prepayment_pct'] is! num ||
+        !(raw['requested_prepayment_pct'] as num).isFinite ||
+        (raw['requested_prepayment_pct'] as num) <= 0 ||
+        (raw['requested_prepayment_pct'] as num) > 100 ||
+        !SelectionTermsEstimate.hasExactStrings(
+          raw['unverified_conditions'],
+          const ['guarantee', 'provider_prepayment_terms'],
+        )) {
+      return null;
+    }
+    final conditions = raw['source_conditions'];
+    if (conditions is! Map ||
+        !SelectionTermsEstimate.hasExactStrings(
+          conditions.keys.toList(),
+          const ['term_months', 'annual_km', 'prepayment_pct'],
+        ) ||
+        conditions['term_months'] is! int ||
+        (conditions['term_months'] as int) <= 0 ||
+        conditions['annual_km'] is! int ||
+        (conditions['annual_km'] as int) < 0 ||
+        conditions['prepayment_pct'] is! num ||
+        conditions['prepayment_pct'] != 0) {
+      return null;
+    }
+    return SelectionPrepaymentEstimate._(
+      monthlyPayment: raw['monthly_payment'] as int,
+      sourceRevision: raw['source_revision'] as String,
+      sourceRecordId: raw['source_record_id'] as String,
+      referenceVehicleTrimId: raw['reference_vehicle_trim_id'] as String,
+      selectionFingerprint: raw['selection_fingerprint'] as String,
+      termMonths: conditions['term_months'] as int,
+      annualKm: conditions['annual_km'] as int,
+      requestedPrepaymentAmount: raw['requested_prepayment_amount'] as int,
+      requestedPrepaymentPct: (raw['requested_prepayment_pct'] as num)
+          .toDouble(),
+    );
+  }
+
+  bool hasSameBinding(SelectionPrepaymentEstimate other) =>
+      monthlyPayment == other.monthlyPayment &&
+      sourceRevision == other.sourceRevision &&
+      sourceRecordId == other.sourceRecordId &&
+      referenceVehicleTrimId == other.referenceVehicleTrimId &&
+      selectionFingerprint == other.selectionFingerprint &&
+      termMonths == other.termMonths &&
+      annualKm == other.annualKm &&
+      requestedPrepaymentAmount == other.requestedPrepaymentAmount &&
+      requestedPrepaymentPct == other.requestedPrepaymentPct;
+
+  /// Validate request units only. Monthly payment is never calculated here.
+  bool matchesConditions({
+    required Object? term,
+    required Object? mileage,
+    required Object? deposit,
+    required Object? prepaymentPct,
+    required Object? selectedVehiclePrice,
+  }) =>
+      term == termMonths &&
+      mileage == annualKm &&
+      deposit == requestedPrepaymentAmount &&
+      prepaymentPct == requestedPrepaymentPct &&
+      selectedVehiclePrice is int &&
+      selectedVehiclePrice > 0 &&
+      (selectedVehiclePrice * requestedPrepaymentPct / 100 -
+                  requestedPrepaymentAmount)
+              .abs() <=
+          1;
+
+  Map<String, dynamic> toJson() => {
+    'version': version,
+    'verified': true,
+    'policy_version': policyVersion,
+    'quote_kind': 'ESTIMATE',
+    'product_type': 'RENTAL',
+    'monthly_payment': monthlyPayment,
+    'source_revision': sourceRevision,
+    'source_record_id': sourceRecordId,
+    'reference_vehicle_trim_id': referenceVehicleTrimId,
+    'selection_fingerprint': selectionFingerprint,
+    'source_conditions': {
+      'term_months': termMonths,
+      'annual_km': annualKm,
+      'prepayment_pct': 0,
+    },
+    'source_prepayment_amount': 0,
+    'requested_prepayment_amount': requestedPrepaymentAmount,
+    'requested_prepayment_pct': requestedPrepaymentPct,
+    'unverified_conditions': ['guarantee', 'provider_prepayment_terms'],
+  };
+}
