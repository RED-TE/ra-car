+class _DelayedResponse {
+  _DelayedResponse(this.request);
+  final RequestOptions request;
+  final result = Completer<Response<dynamic>>();
+  void rows(String id, int monthly) =>
+      result.complete(Response(requestOptions: request, statusCode: 200, data: [
+        {
+          'id': id,
+          'finance_company': 'SYNTHETIC',
+          'finance_company_kr': id,
+          'product_type': 'RENTAL',
+          'contract_months': request.queryParameters['contract_months'],
+          'prepay_pct': request.queryParameters['prepay_pct'],
+          'annual_km': request.queryParameters['annual_km'],
+          'monthly_payment': monthly,
+          'residual_value': 0,
+          'residual_ratio': 0,
+        }
+      ]));
+  void empty() => result.complete(
+      Response(requestOptions: request, statusCode: 200, data: <dynamic>[]));
+  void error(int status) => result.completeError(DioException(
+      requestOptions: request,
+      response: Response(requestOptions: request, statusCode: status)));
+  void estimate(int monthly, {bool strict = false}) {
+    final data = syntheticSelectionTermsQuote();
+    data['vehicle_id'] = (request.data as Map)['vehicle_id'];
+    data['monthly_payment'] = monthly;
+    (data['selection_terms_estimate'] as Map)['monthly_payment'] = monthly;
+    if (strict) {
+      data.remove('selection_terms_estimate');
+      data['condition_verified_monthly_payment'] = monthly;
+      final proof = data['price_provenance'] as Map;
+      proof['request_conditions_verified'] = true;
+      proof['sales_ai_eligible'] = true;
+      proof['unsupported_reasons'] = <String>[];
+      (proof['market_price'] as Map)['match_status'] = 'EXACT';
+      (proof['market_price'] as Map)['unknown_reasons'] = <String>[];
+    }
+    result.complete(Response(requestOptions: request, statusCode: 200, data: {
+      'data': data,
+      'meta': {'trace_id': 'SYNTHETIC-DELAYED'}
+    }));
+  }
+}
