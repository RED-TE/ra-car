+class _OfflineQuotes extends Interceptor {
+  final paths = <String>[];
+  final quoteBodies = <Map<String, dynamic>>[];
+  bool hasDefault = true;
+  void Function(Map<String, dynamic>)? mutate;
+  void Function(Map<String, dynamic>)? mutateDetail;
+
+  @override
+  void onRequest(RequestOptions request, RequestInterceptorHandler handler) {
+    paths.add(request.path);
+    if (request.path == '/api/v1/vehicles/catalog/version') {
+      handler.resolve(Response(requestOptions: request, statusCode: 304));
+    } else if (request.path == '/api/v1/vehicles/SYNTHETIC-VEHICLE') {
+      final data = <String, dynamic>{
+        'id': 'SYNTHETIC-VEHICLE',
+        'brand': 'SYNTHETIC',
+        'model_name': 'SYNTHETIC',
+        'segment': 'sedan',
+        'fuel': 'gasoline',
+        'year': 2026,
+        'base_price': 10000000,
+        if (hasDefault) 'default_vehicle_trim_id': 'SYNTHETIC-TRIM',
+        'trims': [
+          {
+            'id': 'SYNTHETIC-TRIM',
+            'name': 'SYNTHETIC',
+            'price': 10000000,
+            'is_available': true,
+            'options': [],
+            'colors': [],
+          },
+        ],
+      };
+      mutateDetail?.call(data);
+      handler.resolve(
+        Response(requestOptions: request, statusCode: 200, data: data),
+      );
+    } else if (request.path == '/api/v1/quotes/instant') {
+      final body = Map<String, dynamic>.from(request.data as Map);
+      quoteBodies.add(body);
+      final data = _data(
+        product: body['product_type'] as String,
+        term: body['term'] as int,
+        mileage: body['mileage_limit'] as int,
+        prepaymentPct: body['prepayment_pct'] as int? ?? 0,
+        selection: QuoteSelection.fromJson(
+          Map<String, dynamic>.from(body['selection'] as Map),
+        ),
+      );
+      mutate?.call(data);
+      handler.resolve(
+        Response(
+          requestOptions: request,
+          statusCode: 200,
+          data: {
+            'data': data,
+            'meta': {'trace_id': 'SYNTHETIC-OFFLINE'},
+          },
+        ),
+      );
+    } else {
+      handler.reject(
+        DioException(
+          requestOptions: request,
+          error: 'Forbidden outbound request in offline test',
+        ),
+      );
+    }
+  }
+}
