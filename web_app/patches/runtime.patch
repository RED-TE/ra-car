+    Map<String, dynamic> data,
+    Object? appliedConditions, {
+    required int deposit,
+    required int? prepaymentPct,
+  }) {
+    if (prepaymentPct != null || deposit <= 0) {
+      return (prepaymentPct ?? data['prepayment_pct']) as num;
+    }
