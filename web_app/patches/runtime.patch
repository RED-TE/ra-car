+import 'dart:convert';
+import 'package:dio/dio.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:recar_app/screens/estimate_bid_detail_screen.dart';
+import 'package:recar_app/services/api_client.dart';
+import 'package:recar_app/theme/app_theme.dart';
+import 'fixtures/estimate_comparison_service_synthetic.dart';
+
+String _plain(Widget widget) => widget is Text
+    ? (widget.data ?? widget.textSpan?.toPlainText() ?? '')
+        .replaceAll('\u2060', '')
+    : '';
+
+Finder _text(String value) => find.byWidgetPredicate((w) => _plain(w) == value);
+
+class _SyntheticBidApi extends Interceptor {
+  _SyntheticBidApi(this.bid);
+  final Map<String, dynamic> bid;
+  final unexpected = <String>[];
+  @override
+  void onRequest(RequestOptions request, RequestInterceptorHandler handler) {
+    if (request.path.contains('/estimate-reports/') &&
+        request.path.contains('/bid/')) {
+      handler.resolve(Response<dynamic>(
+          requestOptions: request, statusCode: 200, data: bid));
+      return;
+    }
+    if (request.path == bid['quote_document_url']) {
+      handler.resolve(Response<List<int>>(
+          requestOptions: request,
+          statusCode: 200,
+          data: utf8.encode('%PDF-1.4 synthetic fixture only')));
+      return;
+    }
+    unexpected.add(request.path);
+    handler.reject(DioException(
+        requestOptions: request,
+        type: DioExceptionType.badResponse,
+        response: Response<dynamic>(requestOptions: request, statusCode: 404)));
+  }
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  final source =
+      jsonDecode(comparisonServiceSyntheticJson) as Map<String, dynamic>;
+  assert(source['synthetic'] == true);
+
+  setUp(() {
+    final previous = FlutterError.onError;
+    FlutterError.onError = (details) {
+      debugPrint(details.toString());
+      previous?.call(details);
+    };
+    addTearDown(() => FlutterError.onError = previous);
+  });
+
+  Future<void> pump(WidgetTester tester, Map<String, dynamic> bid,
+      {double width = 390, double scale = 1, double height = 1000}) async {
+    tester.view.physicalSize = Size(width, height);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.resetPhysicalSize);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    final interceptor = _SyntheticBidApi(bid);
+    ApiClient.dio.interceptors.insert(0, interceptor);
+    addTearDown(() {
+      ApiClient.dio.interceptors.remove(interceptor);
+      expect(interceptor.unexpected, isEmpty);
+    });
+    await tester.pumpWidget(MaterialApp(
+        theme: AppTheme.light(),
+        builder: (context, child) => MediaQuery(
+            data: MediaQuery.of(context)
+                .copyWith(textScaler: TextScaler.linear(scale)),
+            child: child!),
+        home: EstimateBidDetailScreen(
+            applicationId: bid['id'], financeCompany: 'KB')));
+    await tester.pumpAndSettle();
+    expect(tester.takeException(), isNull);
+  }
+
+  for (final width in [320.0, 390.0]) {
+    for (final scale in [1.0, 2.0]) {
+      testWidgets('actual synthetic SENT source stays readable $width/$scale',
+          (tester) async {
+        final bid = Map<String, dynamic>.from(source['delivered_bid']);
+        await pump(tester, bid, width: width, scale: scale);
+        expect(_text('215,400'), findsOneWidget);
+        expect(find.text('이 조건으로 진행하기'), findsOneWidget);
+        final total = _text('만기에 인수하면 총 (선납금 별도)');
+        await tester.scrollUntilVisible(total, 250, maxScrolls: 12);
+        await tester.pumpAndSettle();
+        expect(_text('12,754,400원'), findsOneWidget);
+        expect(_text('13,754,400원'), findsNothing);
+        expect(find.byWidgetPredicate((w) => _plain(w).contains('36개월')),
+            findsWidgets);
+        expect(find.byWidgetPredicate((w) => _plain(w).contains('60개월')),
+            findsNothing);
+        expect(tester.takeException(), isNull);
+      });
+    }
+  }
+
+  testWidgets(
+      'missing source conditions keep monthly and PDF but no guessed totals',
+      (tester) async {
+    final bid = Map<String, dynamic>.from(source['delivered_bid']);
+    bid['comparison'] = {
+      ...bid['comparison'] as Map<String, dynamic>,
+      'conditions': null
+    };
+    // Deliberately leave legacy response amounts/60-month fallbacks populated.
+    bid['contract_months'] = 60;
+    await pump(tester, bid, height: 2800);
+    expect(_text('215,400'), findsOneWidget);
+    expect(_text('확인 필요'), findsWidgets);
+    expect(_text('12,754,400원'), findsNothing);
+    expect(find.byWidgetPredicate((w) => _plain(w).contains('60개월')),
+        findsNothing);
+    expect(find.text('견적서 보기'), findsOneWidget);
+    expect(find.text('이 조건으로 진행하기'), findsOneWidget);
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets(
+      'missing monthly preserves owned SENT PDF and disables contract CTA',
+      (tester) async {
+    final bid = Map<String, dynamic>.from(source['delivered_bid']);
+    bid['monthly_payment'] = 0;
+    await pump(tester, bid, height: 2800);
+    expect(find.byKey(const ValueKey('bid-price-unavailable')), findsOneWidget);
+    expect(find.text('견적서 보기'), findsOneWidget);
+    expect(find.text('이 조건으로 진행하기'), findsNothing);
+    final action = find.widgetWithText(FilledButton, '금액 확인 후 요청 가능');
+    expect(action, findsOneWidget);
+    expect(tester.widget<FilledButton>(action).onPressed, isNull);
+    expect(tester.takeException(), isNull);
+  });
+}
