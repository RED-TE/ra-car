diff --git a/app/test/quote_default_selection_cancel_test.dart b/app/test/quote_default_selection_cancel_test.dart
new file mode 100644
--- /dev/null
+++ b/app/test/quote_default_selection_cancel_test.dart
@@ -0,0 +1,304 @@
+// SYNTHETIC ONLY. Every request is intercepted; no external API is contacted.
+import 'dart:async';
+
+import 'package:dio/dio.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:recar_app/models/quote.dart';
+import 'package:recar_app/models/quote_selection.dart';
+import 'package:recar_app/services/api_client.dart';
+import 'package:recar_app/services/quote_api.dart';
+import 'package:recar_app/services/vehicle_api.dart';
+import 'package:recar_app/services/vehicle_cache.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'support/synthetic_selection_terms_estimate.dart';
+
+class _HeldDefaultRequests extends Interceptor {
+  final paths = <String>[];
+  final quoteRequests = <RequestOptions>[];
+  final detailStarted = Completer<void>();
+  final quoteStarted = Completer<void>();
+  RequestInterceptorHandler? detailHandler;
+  RequestOptions? detailRequest;
+  RequestInterceptorHandler? quoteHandler;
+  bool holdQuote = false;
+
+  @override
+  void onRequest(RequestOptions options, RequestInterceptorHandler handler) {
+    paths.add(options.path);
+    if (options.path.endsWith('/catalog/version')) {
+      handler.resolve(Response(requestOptions: options, statusCode: 304));
+    } else if (options.path == '/api/v1/vehicles/$syntheticScopedVehicle') {
+      detailRequest = options;
+      detailHandler = handler;
+      detailStarted.complete();
+    } else if (options.path == '/api/v1/quotes/instant') {
+      quoteRequests.add(options);
+      quoteStarted.complete();
+      if (holdQuote) {
+        quoteHandler = handler;
+      } else {
+        handler.resolve(_quoteResponse(options));
+      }
+    } else {
+      handler.reject(DioException(
+        requestOptions: options,
+        error: 'External request forbidden in this synthetic test',
+      ));
+    }
+  }
+
+  Response<Map<String, dynamic>> _quoteResponse(RequestOptions request) =>
+      Response(requestOptions: request, statusCode: 200, data: {
+        'data': syntheticSelectionTermsQuote(),
+        'meta': {'trace_id': 'SYNTHETIC-CANCELLATION'},
+      });
+
+  void completeDetail() {
+    final handler = detailHandler;
+    if (handler == null) return;
+    detailHandler = null;
+    handler.resolve(Response(
+      requestOptions: detailRequest!,
+      statusCode: 200,
+      data: {
+        'id': syntheticScopedVehicle,
+        'brand': '합성',
+        'model_name': '합성 차량',
+        'segment': 'suv',
+        'fuel': 'gas',
+        'year': 2026,
+        'base_price': 45000000,
+        'default_vehicle_trim_id': syntheticScopedTrim,
+        'trims': [
+          {
+            'id': syntheticScopedTrim,
+            'name': '합성 트림',
+            'price': 45000000,
+            'is_available': true,
+            'options': [],
+            'colors': [],
+          },
+        ],
+      },
+    ));
+  }
+
+  void completeQuote() {
+    final handler = quoteHandler;
+    if (handler == null) return;
+    quoteHandler = null;
+    handler.resolve(_quoteResponse(quoteRequests.single));
+  }
+
+  void completeHeld() {
+    completeDetail();
+    completeQuote();
+  }
+}
+
+class _QuoteObservation {
+  _QuoteObservation(Future<QuoteEnvelope> pending) {
+    settled = pending.then<void>((value) {
+      result = value;
+      done = true;
+    }, onError: (Object failure, StackTrace stack) {
+      error = failure;
+      done = true;
+    });
+  }
+
+  late final Future<void> settled;
+  QuoteEnvelope? result;
+  Object? error;
+  bool done = false;
+}
+
+Future<void> _pumpUntil(
+  WidgetTester tester,
+  bool Function() ready, {
+  required String phase,
+}) async {
+  // Dio interceptor dispatch can require several zero-delay event turns.
+  // Bound the wait and advance the test clock explicitly, never wall time.
+  for (var attempt = 0; attempt < 100 && !ready(); attempt++) {
+    await tester.pump(const Duration(milliseconds: 1));
+  }
+  expect(ready(), isTrue, reason: '$phase did not finish within 100 fake ms');
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late _HeldDefaultRequests requests;
+  final activeTokens = <CancelToken>[];
+  setUp(() async {
+    activeTokens.clear();
+    SharedPreferences.setMockInitialValues({});
+    await SharedPreferences.getInstance();
+    VehicleCache.invalidateAll();
+    requests = _HeldDefaultRequests();
+    ApiClient.dio.interceptors.insert(0, requests);
+    // Finish the intercepted catalog refresh before entering a widget test's
+    // fake clock. Its own timeout must not outlive an assertion failure.
+    await VehicleApi.refreshCatalog();
+    requests.paths.clear();
+  });
+  tearDown(() {
+    for (final token in activeTokens) {
+      token.cancel('Synthetic teardown');
+    }
+    requests.completeHeld();
+    ApiClient.dio.interceptors.remove(requests);
+    VehicleCache.invalidateAll();
+  });
+
+  Future<QuoteEnvelope> quote(CancelToken token, {bool explicitSelection = false}) {
+    activeTokens.add(token);
+    return QuoteApi.createInstantQuote(
+        vehicleId: syntheticScopedVehicle,
+        selection: explicitSelection
+            ? QuoteSelection(vehicleTrimId: syntheticScopedTrim)
+            : null,
+        term: 60,
+        mileageLimit: 10000,
+        prepaymentPct: 0,
+        guaranteePct: 0,
+        allowSelectionTermsEstimate: true,
+        cancelToken: token,
+      );
+  }
+
+  final isCancellation = isA<DioException>().having(
+      (error) => error.type, 'type', DioExceptionType.cancel);
+
+  test('an already cancelled request never starts default discovery or POST',
+      () async {
+    final token = CancelToken()..cancel('Synthetic cancellation');
+    await expectLater(quote(token), throwsA(isCancellation));
+    expect(requests.paths, isEmpty);
+  });
+
+  test('cancel during default discovery returns promptly and prevents late POST',
+      () async {
+    final token = CancelToken();
+    final pending = quote(token);
+    final rejected = expectLater(pending, throwsA(isCancellation));
+    await requests.detailStarted.future;
+    token.cancel('Synthetic condition change');
+    await rejected; // Completion must not depend on the held GET resolving.
+    requests.completeDetail();
+    await Future<void>.delayed(Duration.zero);
+    expect(requests.quoteRequests, isEmpty);
+  });
+
+  testWidgets('the web deadline includes default discovery and prevents late POST',
+      (tester) async {
+    final token = CancelToken();
+    final startedAt = tester.binding.clock.now();
+    final observed = _QuoteObservation(quote(token));
+    try {
+      await _pumpUntil(tester, () => requests.detailStarted.isCompleted,
+          phase: 'default detail dispatch');
+      final elapsed = tester.binding.clock.now().difference(startedAt);
+      await tester.pump(QuoteApi.requestTimeout - elapsed - const Duration(milliseconds: 1));
+      expect(observed.done, isFalse, reason: 'The 20-second deadline has not elapsed');
+      expect(token.isCancelled, isFalse);
+      await tester.pump(const Duration(milliseconds: 1));
+      await _pumpUntil(tester, () => observed.done, phase: 'default detail deadline');
+      expect(observed.error, isA<TimeoutException>());
+      expect(token.isCancelled, isTrue);
+      requests.completeDetail();
+      for (var turn = 0; turn < 10; turn++) {
+        await tester.pump(const Duration(milliseconds: 1));
+      }
+      expect(requests.quoteRequests, isEmpty);
+    } finally {
+      token.cancel('Synthetic cleanup');
+      requests.completeHeld();
+      await _pumpUntil(tester, () => observed.done, phase: 'default test cleanup');
+      await observed.settled;
+      for (var turn = 0; turn < 10; turn++) {
+        await tester.pump(const Duration(milliseconds: 1));
+      }
+    }
+  });
+
+  test('completed official default keeps the caller token and selection contract',
+      () async {
+    final token = CancelToken();
+    final pending = quote(token);
+    await requests.detailStarted.future;
+    requests.completeDetail();
+    final accepted = await pending;
+    expect(accepted.data.monthlyPayment, 277300);
+    expect(accepted.data.isSelectionTermsEstimate, isTrue);
+    expect(requests.quoteRequests.single.cancelToken, same(token));
+    final body = requests.quoteRequests.single.data as Map;
+    expect(body['selection_contract_version'], 'selection_v1');
+    expect(body['selection']['vehicle_trim_id'], syntheticScopedTrim);
+    expect(body.containsKey('selection_terms_estimate'), isFalse);
+    expect(body.containsKey('vehicle_price_override'), isFalse);
+  });
+
+  testWidgets('the same deadline cancels an in-flight quote POST', (tester) async {
+    requests.holdQuote = true;
+    final token = CancelToken();
+    final startedAt = tester.binding.clock.now();
+    final observed = _QuoteObservation(quote(token, explicitSelection: true));
+    try {
+      await _pumpUntil(tester, () => requests.quoteStarted.isCompleted,
+          phase: 'quote POST dispatch');
+      expect(requests.quoteRequests.single.cancelToken, same(token));
+      final elapsed = tester.binding.clock.now().difference(startedAt);
+      await tester.pump(QuoteApi.requestTimeout - elapsed - const Duration(milliseconds: 1));
+      expect(observed.done, isFalse, reason: 'The 20-second deadline has not elapsed');
+      await tester.pump(const Duration(milliseconds: 1));
+      await _pumpUntil(tester, () => observed.done, phase: 'quote POST deadline');
+      expect(observed.error, isA<TimeoutException>());
+      expect(token.isCancelled, isTrue);
+      requests.completeQuote();
+      await tester.pump();
+      expect(requests.quoteRequests, hasLength(1));
+    } finally {
+      token.cancel('Synthetic cleanup');
+      requests.completeHeld();
+      await _pumpUntil(tester, () => observed.done, phase: 'quote POST test cleanup');
+      await observed.settled;
+      for (var turn = 0; turn < 10; turn++) {
+        await tester.pump(const Duration(milliseconds: 1));
+      }
+    }
+  });
+
+  testWidgets('default discovery and POST share one 20-second budget', (tester) async {
+    requests.holdQuote = true;
+    final token = CancelToken();
+    final startedAt = tester.binding.clock.now();
+    final observed = _QuoteObservation(quote(token));
+    try {
+      await _pumpUntil(tester, () => requests.detailStarted.isCompleted,
+          phase: 'shared-budget default dispatch');
+      await tester.pump(const Duration(seconds: 8));
+      requests.completeDetail();
+      await _pumpUntil(tester, () => requests.quoteStarted.isCompleted,
+          phase: 'shared-budget POST dispatch');
+      final elapsed = tester.binding.clock.now().difference(startedAt);
+      await tester.pump(QuoteApi.requestTimeout - elapsed - const Duration(milliseconds: 1));
+      expect(observed.done, isFalse);
+      expect(token.isCancelled, isFalse);
+      await tester.pump(const Duration(milliseconds: 1));
+      await _pumpUntil(tester, () => observed.done, phase: 'shared request deadline');
+      expect(observed.error, isA<TimeoutException>());
+      expect(token.isCancelled, isTrue);
+      expect(requests.quoteRequests, hasLength(1));
+    } finally {
+      token.cancel('Synthetic cleanup');
+      requests.completeHeld();
+      await _pumpUntil(tester, () => observed.done, phase: 'shared-budget cleanup');
+      await observed.settled;
+      for (var turn = 0; turn < 10; turn++) {
+        await tester.pump(const Duration(milliseconds: 1));
+      }
+    }
+  });
+}
