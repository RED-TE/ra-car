+// SYNTHETIC ONLY. All HTTP is intercepted; no server or stored quote is changed.
+import 'dart:convert';
+
+import 'package:dio/dio.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:recar_app/models/quote.dart';
+import 'package:recar_app/models/quote_selection.dart';
+import 'package:recar_app/services/api_client.dart';
+import 'package:recar_app/services/quote_api.dart';
+import 'package:recar_app/services/quote_price_evidence.dart';
+import 'package:recar_app/services/vehicle_cache.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'support/synthetic_quote_evidence.dart';
+
+final _selection = QuoteSelection(vehicleTrimId: 'SYNTHETIC-TRIM');
+
+Map<String, dynamic> _data({
+  String product = 'RENTAL',
+  int term = 60,
+  int mileage = 10000,
+  int prepaymentPct = 0,
+  QuoteSelection? selection,
+}) {
+  final selected = selection ?? _selection;
+  final proof = syntheticQuoteEvidence(
+    productType: product,
+    term: term,
+    mileage: mileage,
+    prepaymentPct: prepaymentPct,
+  );
+  if (selected.selectedOptionIds.isNotEmpty) {
+    (proof['unsupported_reasons'] as List).add('OPTIONS_OUT_OF_INITIAL_SCOPE');
+    proof['sales_ai_eligible'] = false;
+  }
+  if (selected.exteriorColorId != null ||
+      selected.interiorColorId != null ||
+      selected.inventoryItemId != null) {
+    (proof['unsupported_reasons'] as List).add(
+      'COLOR_OR_INVENTORY_OUT_OF_INITIAL_SCOPE',
+    );
+    proof['sales_ai_eligible'] = false;
+  }
+  return {
+    'tier': 'SYNTHETIC',
+    'vehicle_id': 'SYNTHETIC-VEHICLE',
+    'vehicle_trim_id': selected.vehicleTrimId,
+    'term': term,
+    'mileage_limit': mileage,
+    'deposit': prepaymentPct * 100000,
+    'prepayment_pct': prepaymentPct,
+    'guarantee': 0,
+    'guarantee_pct': 0,
+    'monthly_payment': 123400,
+    'otd_total': 10000000,
+    'vehicle_price': 10000000,
+    'residual_value': 3000000,
+    'residual_pct': 0.3,
+    'promo_discount': 0,
+    'estimated_discount': 0,
+    'estimated_taxes': 0,
+    'breakdown': <dynamic>[],
+    'normalized_selection': selected.toJson(),
+    'selection_contract_version': 'selection_v1',
+    'selection_fingerprint': 'SYNTHETIC-FINGERPRINT',
+    'pricing_context_version': 'SYNTHETIC-CONTEXT',
+    'selected_vehicle_price': 10000000,
+    'price_source': 'CHAZM_IMPORTED',
+    'pricing_basis': 'MARKET_SELECTION_DELTA_V1',
+    'market_pricing_applied': true,
+    'trim_pricing_applied': true,
+    'price_provenance': proof,
+  };
+}
+
+void _validate(
+  Map<String, dynamic> data, {
+  String product = 'RENTAL',
+  int term = 60,
+  int mileage = 10000,
+  int? prepaymentPct = 0,
+  int deposit = 0,
+  int guarantee = 0,
+  int? guaranteePct = 0,
+  QuoteSelection? selection,
+}) =>
+    QuotePriceEvidence.validate(
+      data,
+      vehicleId: 'SYNTHETIC-VEHICLE',
+      selection: selection ?? _selection,
+      productType: product,
+      term: term,
+      mileageLimit: mileage,
+      prepaymentPct: prepaymentPct,
+      guaranteePct: guaranteePct,
+      deposit: deposit,
+      guarantee: guarantee,
+    );
+
+Map<String, dynamic> _proof(Map<String, dynamic> data) =>
+    data['price_provenance'] as Map<String, dynamic>;
+Map<String, dynamic> _market(Map<String, dynamic> data) =>
+    _proof(data)['market_price'] as Map<String, dynamic>;
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  test(
+    '64 exact synthetic rental period/mileage/advance rows retain amount',
+    () {
+      var checked = 0;
+      for (final product in ['RENTAL']) {
+        for (final term in [24, 36, 48, 60]) {
+          for (final mileage in [10000, 15000, 20000, 30000]) {
+            for (final advance in [0, 10, 20, 30]) {
+              final data = _data(
+                product: product,
+                term: term,
+                mileage: mileage,
+                prepaymentPct: advance,
+              );
+              _validate(
+                data,
+                product: product,
+                term: term,
+                mileage: mileage,
+                prepaymentPct: advance,
+              );
+              expect(QuoteData.fromJson(data).monthlyPayment, 123400);
+              checked++;
+            }
+          }
+        }
+      }
+      expect(checked, 64);
+    },
+  );
