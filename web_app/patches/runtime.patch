+
+class KakaoWebLoginException implements Exception {
+  const KakaoWebLoginException(this.message);
+  final String message;
+}
+
+class KakaoWebLogin {
+  KakaoWebLogin(
+      {KakaoWebBrowser? browser, Dio? client, DateTime Function()? now})
+      : _browser = browser ?? KakaoWebBrowser(),
+        _client = client ?? ApiClient.dio,
+        _now = now ?? DateTime.now;
+
+  static final instance = KakaoWebLogin();
+  final KakaoWebBrowser _browser;
+  final Dio _client;
+  final DateTime Function() _now;
+
+  static bool isCallback(Uri uri) =>
+      uri.queryParameters.containsKey('code') ||
+      uri.queryParameters.containsKey('error');
+
+  Future<void> start() async {
+    _browser.clearPending();
+    final random = Random.secure();
+    final verifier =
+        base64UrlEncode(List.generate(48, (_) => random.nextInt(256)))
+            .replaceAll('=', '');
+    final challenge =
+        base64UrlEncode(sha256.convert(utf8.encode(verifier)).bytes)
+            .replaceAll('=', '');
+    final current = _browser.uri;
+    final redirectUri = Uri.parse(current.origin).replace(
+      path: current.path.startsWith('/app/') ? '/app/' : '/',
+    );
+    final response = await _client.post<Map<String, dynamic>>(
+      '/api/v1/users/oauth/kakao/web/start',
+      data: {
+        'redirect_uri': redirectUri.toString(),
+        'code_challenge': challenge
+      },
+    );
+    final data = response.data ?? {};
+    final authorization =
+        Uri.tryParse(data['authorization_url'] as String? ?? '');
+    final state = data['state'] as String?;
+    if (authorization == null ||
+        authorization.scheme != 'https' ||
+        authorization.host != 'kauth.kakao.com' ||
+        authorization.path != '/oauth/authorize' ||
+        authorization.userInfo.isNotEmpty ||
+        state == null ||
+        state.isEmpty ||
+        authorization.queryParameters['state'] != state ||
+        authorization.queryParameters['redirect_uri'] !=
+            redirectUri.toString() ||
+        authorization.queryParameters['code_challenge'] != challenge ||
+        authorization.queryParameters['code_challenge_method'] != 'S256') {
+      throw const KakaoWebLoginException('카카오 로그인 연결 정보를 확인하지 못했습니다.');
+    }
+    try {
+      _browser.writePending(jsonEncode({
+        'state': state,
+        'verifier': verifier,
+        'expires_at':
+            _now().add(const Duration(minutes: 10)).millisecondsSinceEpoch,
+      }));
+      _browser.navigate(authorization);
+    } catch (_) {
+      _browser.clearPending();
+      throw const KakaoWebLoginException(
+          '브라우저 저장소를 사용할 수 없습니다. 일반 브라우저에서 다시 시도해 주세요.');
+    }
+  }
+
+  Future<OAuthLoginResult> complete() async {
+    final uri = _browser.uri;
+    final rawPending = _browser.readPending();
+    // Remove provider codes before session storage, analytics or API work.
+    final cleanQuery = Map<String, String>.from(uri.queryParameters)
+      ..removeWhere((key, _) =>
+          {'code', 'state', 'error', 'error_description'}.contains(key));
+    _browser.replaceUrl(
+        uri.replace(queryParameters: cleanQuery, fragment: '/login'));
+    _browser.clearPending();
+    Map<String, dynamic> pending;
+    try {
+      pending = jsonDecode(rawPending ?? '') as Map<String, dynamic>;
+    } catch (_) {
+      throw const KakaoWebLoginException(
+          '로그인 확인 정보가 없습니다. 카카오 로그인을 다시 시작해 주세요.');
+    }
+    if (pending['state'] != uri.queryParameters['state'] ||
+        pending['verifier'] is! String ||
+        pending['expires_at'] is! int ||
+        _now().millisecondsSinceEpoch >= (pending['expires_at'] as int)) {
