+/// Rolls individual digits only after a new verified amount is supplied.
+class RollingMoneyText extends StatefulWidget {
+  const RollingMoneyText({
+    super.key,
+    required this.amount,
+    required this.style,
+    this.loading = false,
+    this.placeholderKey,
+    this.duration = const Duration(milliseconds: 640),
+  });
+
+  final int? amount;
+  final TextStyle style;
+  final bool loading;
+  final Key? placeholderKey;
+  final Duration duration;
+
+  @override
+  State<RollingMoneyText> createState() => _RollingMoneyTextState();
+}
+
+class _RollingMoneyTextState extends State<RollingMoneyText>
+    with SingleTickerProviderStateMixin {
+  late final AnimationController _controller;
+  int? _target;
+  Map<int, double> _from = {};
+  Map<int, double> _to = {};
+
+  @override
+  void initState() {
+    super.initState();
+    _controller = AnimationController(vsync: this, duration: widget.duration);
+    _setTarget(widget.loading ? null : widget.amount);
+  }
+
+  double _position(int column) {
+    final end = _to[column] ?? 0;
+    final start = _from[column] ?? end;
+    return start +
+        (end - start) * Curves.easeOutCubic.transform(_controller.value);
+  }
+
+  void _setTarget(int? amount) {
+    if (amount == null || amount <= 0 || amount == _target) return;
+    final previous = _target;
+    final digits = amount.toString().split('').reversed.toList();
+    final starts = <int, double>{};
+    final ends = <int, double>{};
+    for (var column = 0; column < digits.length; column++) {
+      final digit = int.parse(digits[column]).toDouble();
+      final start = previous == null ? digit : _position(column);
+      final currentDigit = start % 10;
+      final forward = previous == null || amount > previous;
+      final distance = forward
+          ? (digit - currentDigit + 10) % 10
+          : -((currentDigit - digit + 10) % 10);
+      starts[column] = start;
+      ends[column] = previous == null || distance.abs() < 0.001
+          ? start
+          : start + distance + (forward ? 10 : -10);
+    }
+    _from = starts;
+    _to = ends;
+    _target = amount;
+    if (previous == null) {
+      _controller.value = 1;
+    } else {
+      _controller.forward(from: 0);
+    }
+  }
+
+  @override
+  void didUpdateWidget(covariant RollingMoneyText oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    _controller.duration = widget.duration;
+    _setTarget(widget.loading ? null : widget.amount);
+    if (widget.loading || widget.amount == null || widget.amount! <= 0) {
+      _controller.stop();
+      _controller.value = 1;
+    }
+  }
+
+  @override
+  void dispose() {
+    _controller.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final style =
+        DefaultTextStyle.of(context).style.merge(widget.style).copyWith(
+      letterSpacing: 0,
+      fontFeatures: const [FontFeature.tabularFigures()],
+    );
+    final textScaler = MediaQuery.textScalerOf(context);
+    final painter = TextPainter(
+      text: TextSpan(text: '0', style: style),
+      textDirection: TextDirection.ltr,
+      textScaler: textScaler,
+    )..layout();
+    final digitWidth = painter.width;
+    final height = painter.height;
+    painter.dispose();
+    final amount = widget.loading ? null : widget.amount;
+    if (amount == null || amount <= 0) {
+      return SizedBox(
+        key: widget.placeholderKey,
+        height: height,
+        child: Center(
+          child: widget.loading
+              ? RecarShimmer.box(width: digitWidth * 6, height: height * 0.75)
+              : Text('—', style: style),
+        ),
+      );
+    }
+    final formatted = amount.toString().replaceAllMapped(
+          RegExp(r'\B(?=(\d{3})+(?!\d))'),
+          (_) => ',',
+        );
+    final reduceMotion = MediaQuery.disableAnimationsOf(context);
+    return Semantics(
+      label: formatted,
+      liveRegion: true,
+      child: ExcludeSemantics(
+        child: AnimatedBuilder(
+          animation: _controller,
+          builder: (context, _) {
+            var column = amount.toString().length;
+            return Row(
+              mainAxisSize: MainAxisSize.min,
+              textDirection: TextDirection.ltr,
+              children: formatted.split('').map((character) {
+                if (character == ',') return Text(',', style: style);
+                column--;
+                final position =
+                    reduceMotion ? _to[column]! : _position(column);
+                final whole = position.floor();
+                final fraction = position - whole;
+                return ClipRect(
+                  child: SizedBox(
+                    width: digitWidth,
+                    height: height,
+                    child: Stack(
+                      clipBehavior: Clip.none,
+                      children: [
+                        for (var offset = 0; offset < 2; offset++)
+                          Positioned(
+                            top: (offset - fraction) * height,
+                            left: 0,
+                            right: 0,
+                            child: Text(
+                              '${(whole + offset) % 10}',
+                              textAlign: TextAlign.center,
+                              style: style,
+                            ),
+                          ),
+                      ],
+                    ),
+                  ),
+                );
+              }).toList(growable: false),
+            );
+          },
+        ),
+      ),
     );
   }
 }
