diff --git a/app/lib/models/selection_terms_estimate.dart b/app/lib/models/selection_terms_estimate.dart
new file mode 100644
--- /dev/null
+++ b/app/lib/models/selection_terms_estimate.dart
@@ -0,0 +1,97 @@
+/// A customer estimate bound to a server calculation, not provider approval.
+/// Missing guarantee evidence must never become a verified zero-guarantee offer.
+class SelectionTermsEstimate {
+  static const version = 'selection_terms_estimate_v1';
+  static const scope = <String>[
+    'vehicle',
+    'trim',
+    'options',
+    'colors',
+    'term',
+    'annual_km',
+    'prepayment_pct',
+  ];
+
+  const SelectionTermsEstimate._({
+    required this.monthlyPayment,
+    required this.sourceRevision,
+    required this.referenceVehicleTrimId,
+    required this.selectionFingerprint,
+  });
+
+  final int monthlyPayment;
+  final String sourceRevision;
+  final String referenceVehicleTrimId;
+  final String selectionFingerprint;
+
+  bool hasSameBinding(SelectionTermsEstimate other) =>
+      monthlyPayment == other.monthlyPayment &&
+      sourceRevision == other.sourceRevision &&
+      referenceVehicleTrimId == other.referenceVehicleTrimId &&
+      selectionFingerprint == other.selectionFingerprint;
+
+  static bool hasExactStrings(Object? value, Iterable<String> expected) {
+    if (value is! List || value.any((item) => item is! String)) return false;
+    final actual = value.cast<String>();
+    final wanted = expected.toSet();
+    return actual.length == wanted.length &&
+        actual.toSet().length == actual.length &&
+        actual.every(wanted.contains);
+  }
+
+  static SelectionTermsEstimate? tryParse(Object? raw) {
+    if (raw is! Map ||
+        !hasExactStrings(raw.keys.toList(), const [
+          'version',
+          'verified',
+          'quote_kind',
+          'monthly_payment',
+          'product_type',
+          'verification_scope',
+          'unverified_conditions',
+          'source_revision',
+          'reference_vehicle_trim_id',
+          'selection_fingerprint',
+        ]) ||
+        raw['version'] != version ||
+        raw['verified'] != true ||
+        raw['quote_kind'] != 'ESTIMATE' ||
+        raw['product_type'] != 'RENTAL' ||
+        raw['monthly_payment'] is! int ||
+        (raw['monthly_payment'] as int) <= 0 ||
+        (raw['monthly_payment'] as int) > 10000000 ||
+        !hasExactStrings(raw['verification_scope'], scope) ||
+        !hasExactStrings(raw['unverified_conditions'], const ['guarantee']) ||
+        raw['source_revision'] is! String ||
+        !RegExp(r'^sha256:[0-9a-f]{64}$')
+            .hasMatch(raw['source_revision'] as String) ||
+        raw['reference_vehicle_trim_id'] is! String ||
+        (raw['reference_vehicle_trim_id'] as String).trim().isEmpty ||
+        (raw['reference_vehicle_trim_id'] as String).trim() !=
+            raw['reference_vehicle_trim_id'] ||
+        raw['selection_fingerprint'] is! String ||
+        !RegExp(r'^[0-9a-f]{64}$')
+            .hasMatch(raw['selection_fingerprint'] as String)) {
+      return null;
+    }
+    return SelectionTermsEstimate._(
+      monthlyPayment: raw['monthly_payment'] as int,
+      sourceRevision: raw['source_revision'] as String,
+      referenceVehicleTrimId: raw['reference_vehicle_trim_id'] as String,
+      selectionFingerprint: raw['selection_fingerprint'] as String,
+    );
+  }
+
+  Map<String, dynamic> toJson() => {
+        'version': version,
+        'verified': true,
+        'quote_kind': 'ESTIMATE',
+        'monthly_payment': monthlyPayment,
+        'product_type': 'RENTAL',
+        'verification_scope': List<String>.of(scope),
+        'unverified_conditions': ['guarantee'],
+        'source_revision': sourceRevision,
+        'reference_vehicle_trim_id': referenceVehicleTrimId,
+        'selection_fingerprint': selectionFingerprint,
+      };
+}
