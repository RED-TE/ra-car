+bool _hasVerifiedFinanceComparison(
+        QuoteComparisonEvidence comparison, List<FinanceQuote> quotes) =>
+    comparison.isVerified &&
+    quotes.isNotEmpty &&
+    quotes.every(
+        (quote) => quote.comparison.isVerified && quote.monthlyPayment > 0);
+
+bool _hasVerifiedAcquisitionQuote(FinanceQuote quote) {
+  final source = quote.comparison;
+  final months = source.conditionInt('contract_months');
+  final residual = source.conditionInt('residual_value');
+  return source.isVerified &&
+      months != null &&
+      months > 0 &&
+      residual != null &&
+      residual == quote.residualValue &&
+      source.conditionInt('prepay_amount') != null &&
+      source.conditionInt('guarantee_amount') != null &&
+      quote.acquisitionTotal == quote.monthlyPayment * months + residual;
+}
 
