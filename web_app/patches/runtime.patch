+    final asset = resolveVehicleAsset(
+      brand: item.brand,
+      modelName: item.modelName,
+      thumbnailUrl: item.thumbnailUrl,
+    );
+    final network = resolveHostedVehicleImageUrl(item.imageUrl) ??
+        resolveHostedVehicleImageUrl(item.thumbnailUrl);
+    Widget remoteOrPlaceholder() => network == null
+        ? _placeholder()
+        : Image.network(
+            network,
+            fit: BoxFit.contain,
+            errorBuilder: (_, __, ___) => _placeholder(),
+          );
+
+    // Use the same verified model-image resolver as the catalog. An unknown
+    // model must not appear as a different, generic vehicle photo.
+    if (asset == null || asset == kVehiclePlaceholderAsset) {
+      return remoteOrPlaceholder();
+    }
+    return Image.asset(
+      asset,
+      fit: BoxFit.contain,
+      errorBuilder: (_, __, ___) => remoteOrPlaceholder(),
+    );
+  }
+
+  Widget _placeholder() => const Center(
+        key: Key('garage-recent-vehicle-placeholder'),
+        child: Icon(
+          Icons.directions_car_outlined,
+          size: 56,
+          color: AppColors.textTertiary,
+        ),
+      );
+}
