index 00000000..9b76b1db
--- /dev/null
+++ b/app/test/vehicle_catalog_refresh_test.dart
@@ -0,0 +1,73 @@
+import 'package:dio/dio.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:recar_app/services/vehicle_catalog_refresh.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  test('new revision, 304, concurrency and five-minute request cap', () async {
+    var now = DateTime.utc(2026, 10, 19);
+    final dio = Dio(BaseOptions(baseUrl: 'https://synthetic.invalid'));
+    var calls = 0;
+    String revision = 'a' * 64;
+    dio.interceptors.add(InterceptorsWrapper(onRequest: (r, h) {
+      calls++;
+      if (calls == 2) {
+        expect(r.headers['If-None-Match'], '"${'a' * 64}"');
+        h.resolve(Response<dynamic>(requestOptions: r, statusCode: 304));
+      } else {
+        h.resolve(Response<dynamic>(requestOptions: r, statusCode: 200, data: {
+          'contract_version': 'catalog_v1',
+          'revision': revision,
+          'complete': true,
+          'total': 0,
+          'items': [],
+        }));
+      }
+    }));
+    final refresh = VehicleCatalogRefresh(dio, now: () => now);
+    final results =
+        await Future.wait(List.generate(10, (_) => refresh.check()));
+    expect(results.every((r) => r), isTrue);
+    expect(calls, 1);
+    expect(await refresh.check(), isFalse);
+    now = now.add(const Duration(minutes: 5));
+    expect(await refresh.check(), isFalse);
+    revision = 'b' * 64;
+    now = now.add(const Duration(minutes: 5));
+    expect(await refresh.check(), isTrue);
+    expect(calls, 3);
+  });
+
+  test('invalid response and failures keep revision and throttle retries',
+      () async {
+    var now = DateTime.utc(2026, 10, 19);
+    final dio = Dio(BaseOptions(baseUrl: 'https://synthetic.invalid'));
+    var calls = 0;
+    dio.interceptors.add(InterceptorsWrapper(onRequest: (r, h) {
+      calls++;
+      if (calls == 2) {
+        h.reject(DioException(
+            requestOptions: r, type: DioExceptionType.connectionTimeout));
+      } else {
+        h.resolve(Response<dynamic>(requestOptions: r, statusCode: 200, data: {
+          'contract_version': 'catalog_v1',
+          'revision': 'a' * 64,
+          'complete': calls != 1,
+          'total': 0,
+          'items': [],
+        }));
+      }
+    }));
+    final refresh = VehicleCatalogRefresh(dio, now: () => now);
+    expect(await refresh.check(), isFalse);
+    expect(await refresh.check(), isFalse);
+    expect(calls, 1);
+    now = now.add(const Duration(minutes: 5));
+    expect(await refresh.check(), isFalse);
+    expect(await refresh.check(), isFalse);
+    expect(calls, 2);
+    now = now.add(const Duration(minutes: 5));
+    expect(await refresh.check(), isTrue);
+  });
+}
