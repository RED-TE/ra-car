new file mode 100644
--- /dev/null
+++ b/app/test/web_selected_price_boundary_test.dart
@@ -0,0 +1,54 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:recar_app/models/quote.dart';
+import 'package:recar_app/models/quote_selection.dart';
+import 'package:recar_app/services/quote_api.dart';
+
+// Immutable historical responses are replayed offline. Mutations below are
+// synthetic counterexamples, not captured provider responses or new prices.
+void main() {
+  final input = File('test/fixtures/ray_quotes_20261016.json');
+  final original = input.readAsBytesSync();
+  final rows = jsonDecode(utf8.decode(original)) as List;
+  final mutations = <String, void Function(Map<String, dynamic>)>{
+    'nearby source condition': (q) =>
+        q['price_provenance']['market_price']['match_status'] = 'NEAREST',
+    'unknown source condition': (q) =>
+        q['price_provenance']['market_price']['unknown_reasons'] =
+            ['SOURCE_CONDITIONS_UNRECORDED'],
+    'missing source points': (q) =>
+        q['price_provenance']['market_price']['source_points'] = [],
+    'different original term': (q) =>
+        q['price_provenance']['market_price']['source_points'][0]
+            ['conditions']['term_months'] = 48,
+  };
+  for (var index = 0; index < rows.length; index++) {
+    for (final mutation in mutations.entries) {
+      test('selected color/options $index reject ${mutation.key}', () {
+        final row = jsonDecode(jsonEncode(rows[index])) as Map<String, dynamic>;
+        final request = row['request'] as Map<String, dynamic>;
+        final data = row['response']['data'] as Map<String, dynamic>;
+        mutation.value(data);
+        expect(
+          () => QuoteApi.validateSelectionResponse(data,
+              vehicleId: request['vehicle_id'] as String,
+              selection: QuoteSelection.fromJson(
+                  Map<String, dynamic>.from(request['selection'] as Map)),
+              productType: request['product_type'] as String,
+              term: request['term'] as int,
+              mileageLimit: request['mileage_limit'] as int,
+              deposit: 0,
+              guarantee: 0,
+              prepaymentPct: request['prepayment_pct'] as int),
+          throwsA(isA<QuoteConditionsUnverified>()),
+        );
+        // Validation of a fresh request must not rewrite a saved response.
+        final saved = rows[index]['response']['data'] as Map<String, dynamic>;
+        expect(QuoteData.fromJson(saved).monthlyPayment, saved['monthly_payment']);
+      });
+    }
+  }
+  tearDownAll(() => expect(input.readAsBytesSync(), original));
+}
