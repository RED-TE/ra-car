diff --git a/app/test/saved_rental_contract_policy_test.dart b/app/test/saved_rental_contract_policy_test.dart
new file mode 100644
--- /dev/null
+++ b/app/test/saved_rental_contract_policy_test.dart
@@ -0,0 +1,151 @@
+// SYNTHETIC ONLY: every request is intercepted; no operational API or DB.
+import 'package:dio/dio.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:recar_app/models/application.dart';
+import 'package:recar_app/models/auth.dart';
+import 'package:recar_app/services/api_client.dart';
+import 'package:recar_app/services/application_api.dart';
+import 'package:recar_app/services/auth_session.dart';
+import 'package:recar_app/services/garage_api.dart';
+import 'package:recar_app/services/quote_price_evidence.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late Interceptor interceptor;
+  late List<RequestOptions> requests;
+  String? savedProduct;
+  late String returnedApplicationId;
+  Future<void> Function()? beforeApplicationRead;
+
+  setUp(() async {
+    SharedPreferences.setMockInitialValues({});
+    await AuthSession.instance.clear();
+    GarageApi.debugRequestContract = null;
+    requests = [];
+    savedProduct = 'long_term_rent';
+    returnedApplicationId = 'SYNTHETIC-APP';
+    beforeApplicationRead = null;
+    interceptor = InterceptorsWrapper(onRequest: (request, handler) async {
+      requests.add(request);
+      if (request.path == '/api/v1/applications/SYNTHETIC-APP') {
+        await beforeApplicationRead?.call();
+        handler.resolve(Response(requestOptions: request, statusCode: 200, data: {
+          'data': {
+            'id': returnedApplicationId,
+            'status': 'APPROVED',
+            'quote_type': savedProduct,
+            'monthly_payment': 277300,
+          },
+          'meta': <String, dynamic>{},
+        }));
+      } else if (request.path ==
+          '/api/v1/applications/SYNTHETIC-APP/request-contract') {
+        handler.resolve(Response(requestOptions: request, statusCode: 200, data: {
+          'requested': true,
+          'already': false,
+          'quote_document_id': 'SYNTHETIC-DOC',
+        }));
+      } else {
+        handler.reject(DioException(
+          requestOptions: request,
+          error: 'Unregistered outbound request forbidden in test',
+        ));
+      }
+    });
+    ApiClient.dio.interceptors.insert(0, interceptor);
+  });
+
+  tearDown(() async {
+    ApiClient.dio.interceptors.remove(interceptor);
+    GarageApi.debugRequestContract = null;
+    await AuthSession.instance.clear();
+  });
+
+  test('new lease application, replacement and snapshot stop before HTTP',
+      () async {
+    await expectLater(
+      ApplicationApi.createApplication(
+          vehicleId: 'SYNTHETIC-VEHICLE', productType: 'LEASE'),
+      throwsA(isA<QuoteConditionsUnverified>()),
+    );
+    await expectLater(
+      ApplicationApi.replaceActiveApplications(
+          vehicleId: 'SYNTHETIC-VEHICLE',
+          idempotencyKey: 'SYNTHETIC-LEASE-REPLACEMENT-BLOCKED',
+          productType: 'lease'),
+      throwsA(isA<QuoteConditionsUnverified>()),
+    );
+    await expectLater(
+      ApplicationApi.saveSnapshot(
+          applicationId: 'SYNTHETIC-APP',
+          snapshot: const QuoteSnapshotRequest(
+              quoteType: 'lease', monthlyPayment: 277300)),
+      throwsA(isA<QuoteConditionsUnverified>()),
+    );
+    expect(requests, isEmpty);
+  });
+
+  for (final product in ['lease', 'LEASE']) {
+    test('saved $product remains readable and cannot start a new contract',
+        () async {
+      savedProduct = product;
+      final saved = await ApplicationApi.getApplication('SYNTHETIC-APP',
+          recordOutcome: false);
+      expect(saved.data.quoteType, product);
+      expect(saved.data.monthlyPayment, 277300);
+      await expectLater(
+        GarageApi.requestContractResult('SYNTHETIC-APP',
+            quoteDocumentId: 'SYNTHETIC-DOC'),
+        throwsA(isA<QuoteConditionsUnverified>()),
+      );
+      expect(requests.map((r) => r.method), ['GET', 'GET']);
+      expect(savedProduct, product);
+    });
+  }
+
+  for (final product in <String?>['long_term_rent', null, 'UNKNOWN']) {
+    test('saved $product sends the unchanged document ID for server verification',
+        () async {
+      savedProduct = product;
+      final result = await GarageApi.requestContractResult('SYNTHETIC-APP',
+          quoteDocumentId: 'SYNTHETIC-DOC');
+      expect(requests.map((r) => r.method), ['GET', 'POST']);
+      expect(requests.last.data, {'quote_document_id': 'SYNTHETIC-DOC'});
+      expect(savedProduct, product);
+      expect(result.quoteDocumentId, 'SYNTHETIC-DOC');
+    });
+  }
+
+  test('mismatched application response prevents the contract POST', () async {
+    returnedApplicationId = 'SYNTHETIC-OTHER-APP';
+    await expectLater(
+      GarageApi.requestContractResult('SYNTHETIC-APP',
+          quoteDocumentId: 'SYNTHETIC-DOC'),
+      throwsA(isA<QuoteConditionsUnverified>()),
+    );
+    expect(requests.map((r) => r.method), ['GET']);
+  });
+
+  test('logout during saved-product read prevents the contract POST', () async {
+    await AuthSession.instance.setSession(
+      accessToken: 'SYNTHETIC-LOCAL-ONLY',
+      user: const AuthUser(
+        id: 'SYNTHETIC-USER',
+        email: 'synthetic@example.invalid',
+        fullName: null,
+        phoneNumber: null,
+        role: 'USER',
+        isActive: true,
+      ),
+    );
+    beforeApplicationRead = () => AuthSession.instance.clear();
+    await expectLater(
+      GarageApi.requestContractResult('SYNTHETIC-APP',
+          quoteDocumentId: 'SYNTHETIC-DOC'),
+      throwsA(isA<QuoteConditionsUnverified>().having(
+          (error) => error.reason, 'reason', 'AUTH_SESSION_CHANGED')),
+    );
+    expect(requests.map((r) => r.method), ['GET']);
+  });
+}
diff --git a/app/test/selection_terms_estimate_test.dart b/app/test/selection_terms_estimate_test.dart
new file mode 100644
--- /dev/null
+++ b/app/test/selection_terms_estimate_test.dart
@@ -0,0 +1,262 @@
+// SYNTHETIC ONLY. No production API, price source, DB or stored quote is used.
+import 'package:dio/dio.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:recar_app/models/quote.dart';
+import 'package:recar_app/models/quote_selection.dart';
+import 'package:recar_app/services/api_client.dart';
+import 'package:recar_app/services/quote_api.dart';
+import 'package:recar_app/services/quote_price_evidence.dart';
+import 'package:recar_app/services/vehicle_cache.dart';
+
+import 'support/synthetic_selection_terms_estimate.dart';
+
+final _selection = QuoteSelection(vehicleTrimId: syntheticScopedTrim);
+void _validate(Map<String, dynamic> data, {bool allow = true}) =>
+    QuotePriceEvidence.validate(
+      data,
+      vehicleId: syntheticScopedVehicle,
+      selection: _selection,
+      productType: 'RENTAL',
+      term: 60,
+      mileageLimit: 10000,
+      deposit: 0,
+      guarantee: 0,
+      prepaymentPct: 0,
+      guaranteePct: 0,
+      allowSelectionTermsEstimate: allow,
+    );
+Map _meta(Map data) => data['selection_terms_estimate'] as Map;
+Map _proof(Map data) => data['price_provenance'] as Map;
+Map _market(Map data) => _proof(data)['market_price'] as Map;
+Map<String, dynamic> _strictWithAdditiveScope() {
+  final data = syntheticSelectionTermsQuote();
+  _market(data)['unknown_reasons'] = <String>[];
+  _market(data)['match_status'] = 'EXACT';
+  _proof(data)['request_conditions_verified'] = true;
+  _proof(data)['sales_ai_eligible'] = true;
+  _proof(data)['unsupported_reasons'] = <String>[];
+  data['condition_verified_monthly_payment'] = data['monthly_payment'];
+  return data;
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  test('explicit customer estimate retains amount without certifying guarantee',
+      () {
+    final data = syntheticSelectionTermsQuote();
+    _validate(data);
+    final parsed = QuoteData.fromJson(data);
+    expect(parsed.monthlyPayment, 277300);
+    expect(parsed.isSelectionTermsEstimate, isTrue);
+    expect(_proof(data)['request_conditions_verified'], isFalse);
+    expect(_proof(data)['sales_ai_eligible'], isFalse);
+    expect(data['condition_verified_monthly_payment'], isNull);
+    expect(_market(data)['unknown_reasons'], ['SOURCE_GUARANTEE_UNRECORDED']);
+  });
+  test('strict/default callers do not opt in implicitly', () {
+    expect(() => _validate(syntheticSelectionTermsQuote(), allow: false),
+        throwsA(isA<QuoteConditionsUnverified>()));
+  });
+  test('missing scoped metadata cannot turn UNKNOWN into a strict price', () {
+    final data = syntheticSelectionTermsQuote()
+      ..remove('selection_terms_estimate');
+    expect(() => _validate(data), throwsA(isA<QuoteConditionsUnverified>()));
+  });
+  test('known EXACT uses the unchanged strict path even with additive scope',
+      () {
+    final data = _strictWithAdditiveScope();
+    final strict = QuotePriceEvidence.validate(data,
+        vehicleId: syntheticScopedVehicle,
+        selection: _selection,
+        productType: 'RENTAL',
+        term: 60,
+        mileageLimit: 10000,
+        deposit: 0,
+        guarantee: 0,
+        prepaymentPct: 0,
+        guaranteePct: 0);
+    expect(strict, isTrue);
+    expect(QuoteData.fromJson(data).isSelectionTermsEstimate, isTrue,
+        reason: 'A response boolean alone is not a local validation outcome.');
+    final parsed =
+        QuoteData.fromJson(data, strictPriceEvidenceAccepted: strict);
+    expect(parsed.selectionTermsEstimate, isNotNull);
+    expect(parsed.isSelectionTermsEstimate, isFalse);
+    expect(parsed.monthlyPayment, 277300);
+  });
+  test('corrupted additive scope cannot fall back to an otherwise strict price',
+      () {
+    final data = _strictWithAdditiveScope();
+    _meta(data)['monthly_payment'] = 1;
+    expect(() => _validate(data, allow: false),
+        throwsA(isA<QuoteConditionsUnverified>()));
+  });
+  final attacks = <String, void Function(Map<String, dynamic>)>{
+    'version': (d) => _meta(d)['version'] = 'v0',
+    'false verification': (d) => _meta(d)['verified'] = false,
+    'confirmed quote': (d) => _meta(d)['quote_kind'] = 'CONFIRMED',
+    'wrong amount': (d) => _meta(d)['monthly_payment'] = 1,
+    'coerced amount': (d) => _meta(d)['monthly_payment'] = '277300',
+    'lease metadata': (d) => _meta(d)['product_type'] = 'LEASE',
+    'scope missing': (d) => _meta(d)['verification_scope'] = ['term'],
+    'scope extra': (d) =>
+        (_meta(d)['verification_scope'] as List).add('guarantee'),
+    'scope duplicate': (d) =>
+        (_meta(d)['verification_scope'] as List).add('term'),
+    'guarantee certified': (d) => _meta(d)['unverified_conditions'] = [],
+    'unknown exclusion': (d) =>
+        _meta(d)['unverified_conditions'] = ['insurance'],
+    'extra private field': (d) => _meta(d)['margin'] = 0,
+    'wrong revision': (d) => _meta(d)['source_revision'] = 'sha256:${'c' * 64}',
+    'malformed revision': (d) => _meta(d)['source_revision'] = 'invalid',
+    'wrong reference trim': (d) =>
+        _meta(d)['reference_vehicle_trim_id'] = 'OTHER',
+    'wrong fingerprint': (d) => _meta(d)['selection_fingerprint'] = 'c' * 64,
+    'malformed object': (d) => d['selection_terms_estimate'] = [],
+    'wrong vehicle': (d) => d['vehicle_id'] = 'OTHER',
+    'wrong trim': (d) => d['vehicle_trim_id'] = 'OTHER',
+    'wrong option': (d) =>
+        (d['normalized_selection'] as Map)['selected_option_ids'] = ['OTHER'],
+    'wrong term': (d) => d['term'] = 36,
+    'wrong mileage': (d) => d['mileage_limit'] = 30000,
+    'nonzero guarantee': (d) => d['guarantee'] = 1,
+    'invented exact guarantee': (d) =>
+        _proof(d)['request_conditions_verified'] = true,
+    'AI eligible': (d) => _proof(d)['sales_ai_eligible'] = true,
+    'provider validity': (d) => _proof(d)['valid_until'] = '2030-01-01',
+    'wrong source': (d) => _market(d)['source'] = 'VEHICLE_QUOTE_LOOKUP',
+    'empty source ID': (d) => _market(d)['source_record_id'] = '',
+    'inconsistent source ID': (d) => _market(d)['source_record_id'] = 'OTHER',
+    'mixed term': (d) => _market(d)['applied_conditions']['term_months'] = 36,
+    'wrong source km': (d) =>
+        _market(d)['applied_conditions']['annual_km'] = 30000,
+    'wrong source advance': (d) =>
+        _market(d)['applied_conditions']['prepayment_pct'] = 20,
+    'nearest': (d) => _market(d)['match_status'] = 'NEAREST',
+    'interpolated': (d) => _market(d)['match_status'] = 'INTERPOLATED',
+    'estimated source': (d) => _market(d)['match_status'] = 'ESTIMATED',
+    'fuzzy': (d) => _market(d)['vehicle_match'] = 'FUZZY',
+    'another unknown': (d) =>
+        (_market(d)['unknown_reasons'] as List).add('SOURCE_TERM_MISMATCH'),
+    'recorded positive guarantee': (d) =>
+        _market(d)['unknown_reasons'] = ['SOURCE_GUARANTEE_UNSUPPORTED'],
+    'wrong method': (d) => _market(d)['methods'] = ['TERM_DIRECT'],
+    'adjustment path': (d) => (_market(d)['source_points'] as List)
+        .first['path'] = 'products.rent.actualMonthly.60',
+    'adjustment role': (d) => (_market(d)['source_points'] as List)
+        .first['role'] = 'ADJUSTMENT_TARGET',
+    'extra point': (d) => (_market(d)['source_points'] as List)
+        .add((_market(d)['source_points'] as List).first),
+    'stale pricing context': (d) => d['pricing_context_version'] = 'old',
+    'unproved pricing path': (d) => d['selection_pricing_applied'] = false,
+    'source alias mismatch': (d) => d['source'] = 'OTHER',
+    'strict amount claim': (d) =>
+        d['condition_verified_monthly_payment'] = 277300,
+  };
+  for (final attack in attacks.entries) {
+    test('rejects ${attack.key} without strict/legacy fallback', () {
+      final data = syntheticSelectionTermsQuote();
+      attack.value(data);
+      expect(() => _validate(data), throwsA(isA<QuoteConditionsUnverified>()));
+    });
+  }
+  test('historical lease without new metadata keeps the stored amount', () {
+    final data = syntheticSelectionTermsQuote()
+      ..remove('selection_terms_estimate')
+      ..['product_type'] = 'LEASE';
+    final saved = QuoteData.fromJson(data);
+    expect(saved.monthlyPayment, 277300);
+    expect(saved.productType, 'LEASE');
+    expect(saved.isSelectionTermsEstimate, isFalse);
+  });
+
+  group('fresh API contract', () {
+    late Interceptor interceptor;
+    late List<RequestOptions> requests;
+    late Map<String, dynamic> responseData;
+    setUp(() {
+      VehicleCache.invalidateAll();
+      requests = [];
+      responseData = syntheticSelectionTermsQuote();
+      interceptor = InterceptorsWrapper(onRequest: (request, handler) {
+        requests.add(request);
+        if (request.path == '/api/v1/quotes/instant') {
+          handler.resolve(
+              Response(requestOptions: request, statusCode: 200, data: {
+            'data': responseData,
+            'meta': {'trace_id': 'SYNTHETIC'}
+          }));
+        } else if (request.path == '/api/v1/vehicles/$syntheticScopedVehicle') {
+          handler.resolve(
+              Response(requestOptions: request, statusCode: 200, data: {
+            'id': syntheticScopedVehicle,
+            'brand': '합성',
+            'model_name': '합성 차량',
+            'segment': 'suv',
+            'fuel': 'gas',
+            'year': 2026,
+            'base_price': 45000000,
+            'default_vehicle_trim_id': syntheticScopedReference,
+            'trims': [
+              for (final id in [syntheticScopedReference, syntheticScopedTrim])
+                {
+                  'id': id,
+                  'name': id,
+                  'price': 45000000,
+                  'is_available': true,
+                  'options': [],
+                  'colors': []
+                }
+            ],
+            'trim_selection': {
+              'mode': 'FLAT',
+              'default_vehicle_trim_id': syntheticScopedReference,
+              'flat_grades': [
+                for (final id in [
+                  syntheticScopedReference,
+                  syntheticScopedTrim
+                ])
+                  {
+                    'vehicle_trim_id': id,
+                    'name': id,
+                    'base_price': 45000000,
+                    'is_active': true
+                  }
+              ]
+            },
+          }));
+        } else if (request.path.endsWith('/catalog/version')) {
+          handler.resolve(Response(requestOptions: request, statusCode: 304));
+        } else {
+          handler.reject(DioException(
+              requestOptions: request, error: 'External request forbidden'));
+        }
+      });
+      ApiClient.dio.interceptors.insert(0, interceptor);
+    });
+    tearDown(() {
+      ApiClient.dio.interceptors.remove(interceptor);
+      VehicleCache.invalidateAll();
+    });
+    Future<QuoteEnvelope> quote({bool allow = false}) =>
+        QuoteApi.createInstantQuote(
+          vehicleId: syntheticScopedVehicle,
+          selection: _selection,
+          term: 60,
+          mileageLimit: 10000,
+          prepaymentPct: 0,
+          guaranteePct: 0,
+          allowSelectionTermsEstimate: allow,
+        );
+    test('API requires local opt-in, never sends a made-up price or proof',
+        () async {
+      await expectLater(quote(), throwsA(isA<QuoteConditionsUnverified>()));
+      final accepted = await quote(allow: true);
+      expect(accepted.data.monthlyPayment, 277300);
+      expect(accepted.data.isSelectionTermsEstimate, isTrue);
+      expect(
+          (requests.last.data as Map).containsKey('selection_terms_estimate'),
+          isFalse);
+    });
+  });
+}
