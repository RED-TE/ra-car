+        reject('SOURCE_RECORD_INCOMPLETE');
+      }
+    }
+    return true;
+  }
+
+  /// Separate, versioned estimate contract. This does not accept arbitrary
+  /// UNKNOWN prices or weaken the strict contract above.
+  static void _validateSelectionTermsEstimate(
+    Map<String, dynamic> data, {
+    required QuoteSelection selection,
+    required String productType,
+    required int term,
+    required int mileageLimit,
+    required int deposit,
+    required int? prepaymentPct,
+  }) {
+    Never reject(String reason) => throw QuoteConditionsUnverified(reason);
+    final estimate =
+        SelectionTermsEstimate.tryParse(data['selection_terms_estimate']);
+    final proof = data['price_provenance'];
+    if (estimate == null ||
+        proof is! Map ||
+        productType != 'RENTAL' ||
+        selection.inventoryItemId != null ||
+        estimate.monthlyPayment != data['monthly_payment'] ||
+        estimate.selectionFingerprint != data['selection_fingerprint'] ||
+        estimate.referenceVehicleTrimId != data['reference_vehicle_trim_id'] ||
+        data['reference_vehicle_price'] is! int ||
+        (data['reference_vehicle_price'] as int) <= 0 ||
+        data['selection_pricing_applied'] != true ||
+        data['market_pricing_applied'] != true ||
+        data['trim_pricing_applied'] != true ||
+        data['selection_pricing_source'] != 'MARKET_SELECTION_DELTA_V1' ||
+        data['pricing_basis'] != 'MARKET_SELECTION_DELTA_V1' ||
+        data['price_source'] != 'CHAZM_IMPORTED' ||
+        (data['source'] != null && data['source'] != data['price_source']) ||
+        data['pricing_context_version'] is! String ||
+        !RegExp(r'^selection-market-v1:[0-9a-f]{16}$')
+            .hasMatch(data['pricing_context_version'] as String) ||
+        proof['version'] != 'price_provenance_v1' ||
+        proof['processed_product_type'] != productType ||
+        proof['quote_kind'] != 'ESTIMATE' ||
+        proof['calculation_method'] !=
+            'MARKET_REFERENCE_PLUS_EXISTING_SELECTION_DELTA' ||
+        proof['provider_generated_at'] != null ||
+        proof['valid_until'] != null) {
+      reject('SELECTION_TERMS_ESTIMATE_INVALID');
+    }
+    final market = proof['market_price'];
+    if (market is! Map ||
+        market['source'] != 'CHAZM_IMPORTED' ||
+        market['product_type'] != productType ||
+        !const ['EXACT', 'NORMALIZED_EXACT']
+            .contains(market['vehicle_match']) ||
+        market['source_record_id'] is! String ||
+        (market['source_record_id'] as String).trim().isEmpty ||
+        data['market_source_record_id'] != market['source_record_id'] ||
+        market['source_revision'] != estimate.sourceRevision ||
+        market['calculation_method'] != 'CHAZM_EXACT_CONDITION_LOOKUP' ||
+        !SelectionTermsEstimate.hasExactStrings(
+            market['methods'], const ['CONDITION_DIRECT'])) {
+      reject('SELECTION_TERMS_SOURCE_INVALID');
+    }
+    final unknown = market['unknown_reasons'];
+    final guaranteeMissing = SelectionTermsEstimate.hasExactStrings(
+        unknown, const ['SOURCE_GUARANTEE_UNRECORDED']);
+    final sourceExact =
+        SelectionTermsEstimate.hasExactStrings(unknown, const <String>[]);
+    if (!((guaranteeMissing && market['match_status'] == 'UNKNOWN') ||
+            (sourceExact && market['match_status'] == 'EXACT')) ||
+        proof['request_conditions_verified'] != !guaranteeMissing ||
+        (data.containsKey('condition_verified_monthly_payment') &&
+            (guaranteeMissing
+                ? data['condition_verified_monthly_payment'] != null
+                : data['condition_verified_monthly_payment'] !=
+                    data['monthly_payment']))) {
+      reject('SELECTION_TERMS_SCOPE_INVALID');
+    }
+    final expectedReasons = <String>{
+      if (guaranteeMissing) 'SOURCE_CONDITIONS_NOT_EXACTLY_VERIFIED',
+      if ((data['deposit'] as num) > 0)
+        'NONZERO_PREPAYMENT_OUT_OF_INITIAL_SCOPE',
+      if (selection.selectedOptionIds.isNotEmpty)
+        'OPTIONS_OUT_OF_INITIAL_SCOPE',
+      if (selection.exteriorColorId != null ||
+          selection.interiorColorId != null)
+        'COLOR_OR_INVENTORY_OUT_OF_INITIAL_SCOPE',
+    };
+    if (!SelectionTermsEstimate.hasExactStrings(
+            proof['unsupported_reasons'], expectedReasons) ||
+        proof['sales_ai_eligible'] != expectedReasons.isEmpty) {
+      reject('SELECTION_TERMS_UNSUPPORTED_CONDITION');
+    }
+    final conditions = market['applied_conditions'];
+    final matches = market['condition_match'];
+    final points = market['source_points'];
+    final pct = _sourcePrepaymentPctForRequest(
+      data,
+      conditions,
+      deposit: deposit,
+      prepaymentPct: prepaymentPct,
+    );
+    bool sameConditions(Object? value) =>
+        value is Map &&
+        value['term_months'] == term &&
+        value['annual_km'] == mileageLimit &&
+        value['prepayment_pct'] == pct;
+    if (pct is! num ||
+        pct != pct.toInt() ||
+        !sameConditions(conditions) ||
+        matches is! Map ||
+        !const ['term_months', 'annual_km', 'prepayment_pct']
+            .every((key) => matches[key] == 'EXACT') ||
+        points is! List ||
+        points.length != 1 ||
+        points.single is! Map ||
+        (points.single as Map)['role'] != 'BASE' ||
+        (points.single as Map)['path'] !=
+            'products.rent.conditionMonthly.$term:${pct.toInt()}:$mileageLimit' ||
+        !sameConditions((points.single as Map)['conditions'])) {
+      reject('SELECTION_TERMS_CONDITIONS_MISMATCH');
+    }
+  }
+}
