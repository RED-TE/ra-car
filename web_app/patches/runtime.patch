+import '../models/quote_selection.dart';
+
+/// A fresh quote lacks evidence for the customer's actual request.
+/// This is intentionally independent of parsing historical saved quotes.
+class QuoteConditionsUnverified implements Exception {
+  const QuoteConditionsUnverified(
+      [this.reason = 'PRICE_CONDITIONS_UNVERIFIED']);
+
+  final String reason;
+
+  @override
+  String toString() => 'QuoteConditionsUnverified($reason)';
+}
+
+/// Validates the public selection_v1 / price_provenance_v1 contract only.
+/// No price, margin, advance-payment or guarantee calculation lives here.
+class QuotePriceEvidence {
+  static const _customerSupportedScopeReasons = <String>{
+    'NONZERO_PREPAYMENT_OUT_OF_INITIAL_SCOPE',
+    'OPTIONS_OUT_OF_INITIAL_SCOPE',
+    'COLOR_OR_INVENTORY_OUT_OF_INITIAL_SCOPE',
+  };
+
+  static void validate(
+    Map<String, dynamic> data, {
+    required String vehicleId,
+    required QuoteSelection selection,
+    required String productType,
+    required int term,
+    required int mileageLimit,
+    required int deposit,
+    required int guarantee,
+    int? prepaymentPct,
+    int? guaranteePct,
+  }) {
+    Never reject(String reason) => throw QuoteConditionsUnverified(reason);
+    bool nonempty(Object? value) => value is String && value.trim().isNotEmpty;
+    bool nonnegative(Object? value) =>
+        value is num && value.isFinite && value >= 0;
+
+    if (!const ['RENTAL', 'LEASE'].contains(productType)) {
+      reject('UNSUPPORTED_PRODUCT');
+    }
+    final normalized = data['normalized_selection'];
+    if (data['vehicle_id'] != vehicleId ||
+        data['vehicle_trim_id'] != selection.vehicleTrimId ||
+        data['selection_contract_version'] != QuoteSelection.contractVersion ||
+        normalized is! Map ||
+        normalized['vehicle_trim_id'] != selection.vehicleTrimId ||
+        normalized['exterior_color_id'] != selection.exteriorColorId ||
+        normalized['interior_color_id'] != selection.interiorColorId ||
+        normalized['inventory_item_id'] != selection.inventoryItemId ||
+        normalized['selected_option_ids'] is! List ||
+        (normalized['selected_option_ids'] as List)
+            .any((id) => id is! String) ||
+        !nonempty(data['selection_fingerprint']) ||
+        !nonempty(data['pricing_context_version']) ||
+        data['selected_vehicle_price'] is! int ||
+        (data['selected_vehicle_price'] as int) <= 0 ||
+        data['monthly_payment'] is! int ||
+        (data['monthly_payment'] as int) <= 0) {
+      reject('SELECTION_OR_AMOUNT_MISMATCH');
+    }
+    try {
+      if (QuoteSelection.fromJson(Map<String, dynamic>.from(normalized)) !=
+          selection) {
+        reject('SELECTION_MISMATCH');
+      }
+    } on QuoteConditionsUnverified {
+      rethrow;
+    } catch (_) {
+      reject('INVALID_NORMALIZED_SELECTION');
+    }
+    if (data['term'] != term || data['mileage_limit'] != mileageLimit) {
+      reject('REQUEST_CONDITIONS_MISMATCH');
+    }
+    if (!nonnegative(data['deposit']) ||
+        (prepaymentPct != null
+            ? data['prepayment_pct'] != prepaymentPct
+            : data['deposit'] != deposit)) {
+      reject('PREPAYMENT_MISMATCH');
+    }
+    // A source-price match is not evidence of a refundable guarantee's effect.
+    if (guarantee != 0 ||
+        (guaranteePct ?? 0) != 0 ||
+        data['guarantee'] != 0 ||
+        (data['guarantee_pct'] != null && data['guarantee_pct'] != 0)) {
+      reject('NONZERO_GUARANTEE_UNVERIFIED');
+    }
+
+    final proof = data['price_provenance'];
+    if (proof is! Map ||
+        proof['version'] != 'price_provenance_v1' ||
+        proof['processed_product_type'] != productType ||
+        proof['request_conditions_verified'] != true ||
+        proof['quote_kind'] != 'ESTIMATE' ||
+        proof['calculation_method'] !=
+            'MARKET_REFERENCE_PLUS_EXISTING_SELECTION_DELTA') {
+      reject('PRICE_PROVENANCE_UNVERIFIED');
+    }
+    final unsupported = proof['unsupported_reasons'];
+    // Sales AI's initial scope excludes otherwise supported paid selections.
+    // Only those documented scope markers are allowed, never unknown reasons.
+    if (unsupported is! List ||
+        unsupported.any((reason) =>
+            reason is! String ||
+            !_customerSupportedScopeReasons.contains(reason))) {
+      reject('UNSUPPORTED_PRICE_CONDITION');
+    }
+    final hasPaidAdvance =
+        data['deposit'] is num && (data['deposit'] as num) > 0;
+    final hasOptions = selection.selectedOptionIds.isNotEmpty;
+    final hasColorsOrInventory = selection.exteriorColorId != null ||
+        selection.interiorColorId != null ||
+        selection.inventoryItemId != null;
+    if ((unsupported.contains('NONZERO_PREPAYMENT_OUT_OF_INITIAL_SCOPE') &&
+            !hasPaidAdvance) ||
+        (unsupported.contains('OPTIONS_OUT_OF_INITIAL_SCOPE') && !hasOptions) ||
+        (unsupported.contains('COLOR_OR_INVENTORY_OUT_OF_INITIAL_SCOPE') &&
+            !hasColorsOrInventory) ||
+        (!hasPaidAdvance &&
+            !hasOptions &&
+            !hasColorsOrInventory &&
+            (proof['sales_ai_eligible'] != true || unsupported.isNotEmpty))) {
+      reject('INCONSISTENT_SUPPORTED_SCOPE');
+    }
+    final market = proof['market_price'];
+    if (market is! Map ||
+        market['product_type'] != productType ||
+        market['match_status'] != 'EXACT' ||
+        !const ['EXACT', 'NORMALIZED_EXACT']
+            .contains(market['vehicle_match']) ||
+        !const ['CHAZM_IMPORTED', 'VEHICLE_QUOTE_LOOKUP']
+            .contains(market['source']) ||
+        market['source'] != (data['price_source'] ?? data['source']) ||
+        !nonempty(market['source_record_id']) ||
+        !nonempty(market['source_revision']) ||
+        !nonempty(market['calculation_method']) ||
+        market['calculation_method'] == 'UNKNOWN') {
+      reject('SOURCE_PRICE_UNVERIFIED');
+    }
+    final unknown = market['unknown_reasons'];
+    final matches = market['condition_match'];
+    final applied = market['applied_conditions'];
+    final resolvedPrepayment = prepaymentPct ?? data['prepayment_pct'];
+    if (unknown is! List ||
+        unknown.isNotEmpty ||
+        matches is! Map ||
+        !const ['term_months', 'annual_km', 'prepayment_pct']
+            .every((key) => matches[key] == 'EXACT') ||
+        applied is! Map ||
+        applied['term_months'] != term ||
+        applied['annual_km'] != mileageLimit ||
+        !nonnegative(resolvedPrepayment) ||
+        (resolvedPrepayment as num) > 100 ||
+        ((data['deposit'] as num) == 0 && resolvedPrepayment != 0) ||
+        ((data['deposit'] as num) > 0 && resolvedPrepayment == 0) ||
+        applied['prepayment_pct'] != resolvedPrepayment) {
+      reject('SOURCE_CONDITIONS_MISMATCH');
+    }
+    final points = market['source_points'];
+    if (points is! List ||
+        points.isEmpty ||
+        points.any((point) {
+          if (point is! Map ||
+              !nonempty(point['path']) ||
+              !const ['BASE', 'ADJUSTMENT_BASE', 'ADJUSTMENT_TARGET']
+                  .contains(point['role'])) {
+            return true;
+          }
+          final conditions = point['conditions'];
+          // Adjustment anchors can use another mileage/advance percentage,
+          // but must record the actual term used by this exact source path.
+          return conditions is! Map ||
+              conditions['term_months'] != term ||
+              !nonnegative(conditions['annual_km']) ||
+              !nonnegative(conditions['prepayment_pct']);
+        })) {
+      reject('SOURCE_RECORD_INCOMPLETE');
+    }
+  }
+}
