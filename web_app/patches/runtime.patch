+};
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  var counter = 0;
+  late Interceptor interceptor;
+  late List<dynamic> rows;
+  var requests = 0;
+
+  setUp(() {
+    rows = [];
+    requests = 0;
+    interceptor = InterceptorsWrapper(
+      onRequest: (request, handler) {
+        requests++;
+        expect(request.path, contains('/quotes'));
+        handler.resolve(
+          Response(requestOptions: request, statusCode: 200, data: rows),
+        );
+      },
+    );
+    ApiClient.dio.interceptors.insert(0, interceptor);
+  });
+  tearDown(() => ApiClient.dio.interceptors.remove(interceptor));
+
+  Future<List<dynamic>> fetch({String product = 'RENTAL'}) =>
+      VehicleApi.fetchVehicleQuotes(
+        'SYNTHETIC-CONDITIONS-${counter++}',
+        contractMonths: 60,
+        prepayPct: 20,
+        annualKm: 10000,
+        productType: product,
+        forceRefresh: true,
+      );
+
+  test('retains the exact row and never alters its server amount', () async {
+    rows = [_row('EXACT')];
+    final result = await fetch();
+    expect(result.single.id, 'EXACT');
+    expect(result.single.monthlyPayment, 280000);
+    expect(requests, 1);
+  });
+
+  final mismatches = <String, void Function(Map<String, dynamic>)>{
+    'term': (row) => row['contract_months'] = 24,
+    'mileage': (row) => row['annual_km'] = 30000,
+    'prepay': (row) => row['prepay_pct'] = 30,
+    'product': (row) => row['product_type'] = 'LEASE',
+    'missing product': (row) => row.remove('product_type'),
+    'missing term': (row) => row.remove('contract_months'),
+    'zero monthly': (row) => row['monthly_payment'] = 0,
+    'negative monthly': (row) => row['monthly_payment'] = -1,
+    'string monthly': (row) => row['monthly_payment'] = '280000',
+    'missing company': (row) => row.remove('finance_company'),
+  };
+  for (final mismatch in mismatches.entries) {
+    test('excludes ${mismatch.key}, preserving other valid rows', () async {
+      final wrong = _row('WRONG')..['monthly_payment'] = 1220;
+      mismatch.value(wrong);
+      rows = [wrong, _row('EXACT')];
+      final result = await fetch();
+      expect(result.map((item) => item.id), ['EXACT']);
+      expect(result.single.monthlyPayment, 280000);
+    });
+  }
+
+  test(
+    'all mismatched rows stay unavailable without invented fallback',
+    () async {
+      rows = [_row('WRONG')..['annual_km'] = 30000, 'malformed'];
+      expect(await fetch(), isEmpty);
+    },
+  );
+
+  test(
+    'unsupported product stops before HTTP instead of becoming RENTAL',
+    () async {
+      await expectLater(fetch(product: 'LOAN'),
+          throwsA(isA<QuoteConditionsUnverified>()));
+      expect(requests, 0);
+    },
+  );
+}
