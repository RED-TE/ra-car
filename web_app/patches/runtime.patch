+++ b/app/lib/services/rental_only_policy.dart
@@ -0,0 +1,49 @@
+/// New customer business is rental-only. This never rewrites saved products.
+class RentalOnlyPolicy {
+  static const productType = 'RENTAL';
+  static const unavailableMessage =
+      '현재 신규 견적과 신청은 장기렌트만 가능해요. 기존 리스 견적과 서류는 계속 볼 수 있어요.';
+  static const unknownProductMessage = '상품 유형을 확인하지 못했어요. 새 장기렌트 견적을 확인해 주세요.';
+
+  static bool isRental(Object? value) =>
+      value is String &&
+      const {
+        'RENTAL',
+        'RENT',
+        'LONG_TERM_RENT',
+        'LONG_RENT',
+        'LONG_RENTAL',
+        '장기렌트',
+        '렌트',
+      }.contains(value.trim().toUpperCase());
+
+  static bool isLease(Object? value) =>
+      value is String &&
+      const {
+        'LEASE',
+        'OPERATING_LEASE',
+        '리스',
+        '운용리스',
+      }.contains(value.trim().toUpperCase());
+
+  /// Only explicit monetary product metadata can identify a rental price.
+  /// Brand, origin and missing fields are never evidence of the product.
+  static bool hasRentalCatalogPrice(Map<String, dynamic> row) {
+    final displayed = row['displayed_product_type'];
+    final monthly = row['monthly_payment_product_type'];
+    if (displayed != null && !isRental(displayed)) return false;
+    if (monthly != null && !isRental(monthly)) return false;
+    return isRental(displayed) || isRental(monthly);
+  }
+
+  static bool allowsCatalogRow(Map<String, dynamic> row) {
+    if (isLease(row['displayed_product_type']) ||
+        isLease(row['monthly_payment_product_type'])) {
+      return false;
+    }
+    final available = row['available_product_types'];
+    return available is! List ||
+        available.isEmpty ||
+        available.any((value) => value is String && isRental(value));
+  }
+}
