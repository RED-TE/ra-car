+/// Server evidence for comparisons, not permission to replace saved amounts.
+/// Missing/older metadata is deliberately unavailable.
+class QuoteComparisonEvidence {
+  final String? version;
+  final String? status;
+  final bool verified;
+  final String? scope;
+  final List<String> reasons;
+  final String? source;
+  final String? sourceRecordId;
+  final Map<String, dynamic>? conditions;
+
+  const QuoteComparisonEvidence({
+    this.version,
+    this.status,
+    this.verified = false,
+    this.scope,
+    this.reasons = const [],
+    this.source,
+    this.sourceRecordId,
+    this.conditions,
+  });
+
+  bool get isVerified =>
+      version == 'customer_quote_comparison_v1' &&
+      status == 'VERIFIED' &&
+      verified &&
+      scope == 'SAME_SELECTION_CUSTOMER_PRICE';
+
+  bool get hasIndividualSource =>
+      (source == 'APPLICATION_ESTIMATE' || source == 'ADMIN_SENT_QUOTE') &&
+      (sourceRecordId?.trim().isNotEmpty ?? false);
+
+  /// Only actual source-condition numbers; never fill null from legacy totals.
+  int? conditionInt(String key) {
+    final value = conditions?[key];
+    if (value is! num || !value.isFinite || value < 0 || value % 1 != 0) {
+      return null;
+    }
+    return value.toInt();
+  }
+
+  factory QuoteComparisonEvidence.fromJson(dynamic json) {
+    if (json is! Map<String, dynamic>) {
+      return const QuoteComparisonEvidence();
+    }
+    return QuoteComparisonEvidence(
+      version: json['version'] is String ? json['version'] as String : null,
+      status: json['status'] is String ? json['status'] as String : null,
+      verified: json['verified'] == true,
+      scope: json['scope'] is String ? json['scope'] as String : null,
+      reasons: (json['reasons'] is List ? json['reasons'] as List : const [])
+          .whereType<String>()
+          .toList(growable: false),
+      source: json['source'] is String ? json['source'] as String : null,
+      sourceRecordId: json['source_record_id'] is String
+          ? json['source_record_id'] as String
+          : null,
+      conditions: json['conditions'] is Map<String, dynamic>
+          ? Map<String, dynamic>.unmodifiable(
+              json['conditions'] as Map<String, dynamic>,
+            )
+          : null,
+    );
+  }
+}
