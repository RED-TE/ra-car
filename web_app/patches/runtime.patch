+    final sourcePct =
+        appliedConditions is Map ? appliedConditions['prepayment_pct'] : null;
+    if (referencePrice is! int ||
+        referencePrice <= 0 ||
+        sourcePct is! num ||
+        !sourcePct.isFinite ||
+        sourcePct < 0 ||
+        sourcePct > 100) {
+      throw const QuoteConditionsUnverified(
+        'SOURCE_PREPAYMENT_REFERENCE_MISMATCH',
+      );
+    }
+    final sourceAmount = referencePrice * sourcePct / 100.0;
+    if (!sourceAmount.isFinite) {
+      throw const QuoteConditionsUnverified(
+        'SOURCE_PREPAYMENT_REFERENCE_MISMATCH',
+      );
+    }
