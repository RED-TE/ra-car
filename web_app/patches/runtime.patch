+    }
+    final code = uri.queryParameters['code'];
+    if (code == null || code.isEmpty) {
+      throw const KakaoWebLoginException('카카오 인증 정보를 받지 못했습니다. 다시 시작해 주세요.');
+    }
+    final response = await _client.post<Map<String, dynamic>>(
+      '/api/v1/users/oauth/kakao/web/complete',
+      data: {
+        'code': code,
+        'state': pending['state'],
+        'code_verifier': pending['verifier']
+      },
+    );
+    final data = response.data!;
+    final token = AuthToken.fromJson(data);
+    final user = AuthUser.fromJson(data['user'] as Map<String, dynamic>);
+    await AuthSession.instance
+        .setSession(accessToken: token.accessToken, user: user);
+    return OAuthLoginResult(user: user, isNewUser: data['is_new_user'] == true);
