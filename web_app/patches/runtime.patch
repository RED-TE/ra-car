+// Synthetic zero-source estimate. Never an operational/source-data recording.
+import 'dart:convert';
+import 'synthetic_selection_terms_estimate.dart';
+
+Map<String, dynamic> syntheticSelectionPrepaymentQuote({
+  int amount = 9000000,
+  double pct = 20,
+  bool paidSelections = false,
+}) {
+  final data = syntheticSelectionTermsQuote()
+    ..remove('selection_terms_estimate')
+    ..['deposit'] = amount
+    ..['prepayment_pct'] = pct;
+  if (paidSelections) {
+    (data['normalized_selection'] as Map).addAll(<String, dynamic>{
+      'selected_option_ids': ['SYNTHETIC-OPTION'],
+      'exterior_color_id': 'SYNTHETIC-EXTERIOR',
+      'interior_color_id': 'SYNTHETIC-INTERIOR',
+    });
+  }
+  data['selection_prepayment_estimate'] = {
+    'version': 'selection_prepayment_estimate_v1',
+    'verified': true,
+    'policy_version': 'zero_prepayment_delta_v1',
+    'quote_kind': 'ESTIMATE',
+    'product_type': 'RENTAL',
+    'monthly_payment': 277300,
+    'source_revision': 'sha256:${'b' * 64}',
+    'source_record_id': 'SYNTHETIC SOURCE',
+    'reference_vehicle_trim_id': syntheticScopedReference,
+    'selection_fingerprint': 'a' * 64,
+    'source_conditions': {
+      'term_months': 60,
+      'annual_km': 10000,
+      'prepayment_pct': 0,
+    },
+    'source_prepayment_amount': 0,
+    'requested_prepayment_amount': amount,
+    'requested_prepayment_pct': pct,
+    'unverified_conditions': ['guarantee', 'provider_prepayment_terms'],
+  };
+  (data['price_provenance'] as Map)['unsupported_reasons'] = [
+    'SOURCE_CONDITIONS_NOT_EXACTLY_VERIFIED',
+    'NONZERO_PREPAYMENT_OUT_OF_INITIAL_SCOPE',
+    if (paidSelections) 'OPTIONS_OUT_OF_INITIAL_SCOPE',
+    if (paidSelections) 'COLOR_OR_INVENTORY_OUT_OF_INITIAL_SCOPE',
+  ];
+  return jsonDecode(jsonEncode(data)) as Map<String, dynamic>;
+}
