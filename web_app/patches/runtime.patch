+      final unrelatedId = 'SYNTHETIC-RECENT-UNRELATED-$sequence';
+      recent.removeByVehicleId(vehicleId);
+      recent.removeByVehicleId(unrelatedId);
+      VehicleListItem item(String id) => VehicleListItem(
+            id: id,
+            brand: '합성',
+            modelName: '기존 합성 리스 차량',
+            segment: 'suv',
+            fuel: 'gas',
+            year: 2026,
+            priceFrom: 45000000,
+            monthlyPayment: 777700,
+            monthlyPaymentProductType: 'LEASE',
+            displayedProductType: 'LEASE',
+            availableProductTypes: const ['LEASE'],
+            thumbnailUrl: 'SYNTHETIC-SAVED-THUMBNAIL',
+          );
+      recent.record(item(unrelatedId), productLabel: '기존 합성 리스');
+      recent.record(item(vehicleId), productLabel: '기존 합성 리스');
+      final before = recent.items
+          .singleWhere((entry) => entry.item.id == vehicleId)
+          .toJson();
+      final unrelatedBefore = recent.items
+          .singleWhere((entry) => entry.item.id == unrelatedId)
+          .toJson();
+      final requests = <RequestOptions>[];
+      final unexpectedRequests = <String>[];
+      final interceptor = InterceptorsWrapper(onRequest: (request, handler) {
+        requests.add(request);
+        if (request.path == '/api/v1/vehicles/catalog/version') {
+          handler.resolve(Response(requestOptions: request, statusCode: 304));
+          return;
+        }
+        if (request.path == '/api/v1/vehicles/$vehicleId') {
+          expect(request.method, 'GET');
+          expect(request.queryParameters['product_type'], 'RENTAL');
+          handler.reject(DioException(
+            requestOptions: request,
+            type: DioExceptionType.badResponse,
+            response: Response(
+              requestOptions: request,
+              statusCode: scenario.status,
+              data: scenario.code == null
+                  ? <String, dynamic>{'detail': 'Vehicle not found'}
+                  : <String, dynamic>{
+                      'error': {
+                        'code': scenario.code,
+                        'message': 'SYNTHETIC price or product unavailable',
+                      },
+                    },
+            ),
+          ));
+          return;
+        }
+        unexpectedRequests.add(request.path);
+        handler.reject(DioException(
+          requestOptions: request,
+          error: 'External request forbidden by the synthetic test',
+        ));
+      });
+      ApiClient.dio.interceptors.insert(0, interceptor);
+      addTearDown(() async {
+        await tester.pumpWidget(const SizedBox.shrink());
+        await tester.pump();
+        ApiClient.dio.interceptors.remove(interceptor);
+        recent.removeByVehicleId(vehicleId);
+        recent.removeByVehicleId(unrelatedId);
+        VehicleCache.invalidateAll();
+      });
+
+      await tester.pumpWidget(MaterialApp(
+        theme: AppTheme.light(),
+        home: VehicleDetailScreen(vehicleId: vehicleId),
+      ));
+      await tester.pumpAndSettle();
+
+      expect(requests.where((request) => request.path ==
+          '/api/v1/vehicles/$vehicleId'), hasLength(1));
+      expect(unexpectedRequests, isEmpty);
+      expect(requests.every((request) => request.method == 'GET'), isTrue);
+      final retained = recent.items.where((entry) => entry.item.id == vehicleId);
+      if (scenario.retain) {
+        expect(retained, hasLength(1));
+        expect(retained.single.toJson(), equals(before),
+            reason: 'Price failure must preserve the stored product, amount, image and viewed time.');
+      } else {
+        expect(retained, isEmpty);
+      }
+      expect(
+          recent.items.singleWhere((entry) => entry.item.id == unrelatedId).toJson(),
+          equals(unrelatedBefore));
+      expect(tester.takeException(), isNull);
+    });
+  }
+}
