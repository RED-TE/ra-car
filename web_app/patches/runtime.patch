+import 'package:web/web.dart' as web;
+
+class KakaoWebBrowser {
+  static const _key = 'recar_kakao_login_pending';
+  Uri get uri => Uri.parse(web.window.location.href);
+  String? readPending() => web.window.sessionStorage.getItem(_key);
+  void writePending(String value) =>
+      web.window.sessionStorage.setItem(_key, value);
+  void clearPending() => web.window.sessionStorage.removeItem(_key);
+  void replaceUrl(Uri value) =>
+      web.window.history.replaceState(null, '', value.toString());
+  void navigate(Uri value) => web.window.location.assign(value.toString());
+}
