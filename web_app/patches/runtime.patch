+            handler.reject(
+              DioException(
+                requestOptions: request,
+                error: 'External request forbidden',
+              ),
+            );
+            return;
+          }
+          handler.resolve(
+            Response(
+              requestOptions: request,
+              statusCode: 200,
+              data: {
+                'data': syntheticSelectionPrepaymentQuote(),
+                'meta': {'trace_id': 'SYNTHETIC'},
+              },
+            ),
+          );
+        },
+      );
+      ApiClient.dio.interceptors.insert(0, interceptor);
+    });
+    tearDown(() => ApiClient.dio.interceptors.remove(interceptor));
+    Future<QuoteEnvelope> request({bool allow = false}) =>
+        QuoteApi.createInstantQuote(
+          vehicleId: syntheticScopedVehicle,
+          selection: QuoteSelection(vehicleTrimId: syntheticScopedTrim),
+          term: 60,
+          mileageLimit: 10000,
+          prepaymentPct: 20,
+          guaranteePct: 0,
+          allowSelectionTermsEstimate: true,
+          allowSelectionPrepaymentEstimate: allow,
+        );
+    test(
+      'only explicitly opted-in calls send policy and accept zero-source proof',
+      () async {
+        await expectLater(request(), throwsA(isA<QuoteConditionsUnverified>()));
+        expect(
+          (requests.last.data as Map).containsKey('estimate_policy_version'),
+          isFalse,
+        );
+        final accepted = await request(allow: true);
+        expect(accepted.data.monthlyPayment, 277300);
+        expect(accepted.data.isSelectionPrepaymentEstimate, isTrue);
+        expect(accepted.data.strictPriceEvidenceAccepted, isFalse);
+        expect(
+          requests.last.data['estimate_policy_version'],
+          'zero_prepayment_delta_v1',
+        );
+        expect(
+          (requests.last.data as Map).containsKey(
+            'selection_prepayment_estimate',
+          ),
+          isFalse,
+        );
+      },
+    );
+  });
+}
