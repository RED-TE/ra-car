diff --git a/app/lib/services/vehicle_catalog_refresh.dart b/app/lib/services/vehicle_catalog_refresh.dart
new file mode 100644
index 00000000..6baa137c
--- /dev/null
+++ b/app/lib/services/vehicle_catalog_refresh.dart
@@ -0,0 +1,63 @@
+import 'package:dio/dio.dart';
+
+/// Discovery-cache freshness only. Never invalidates or recalculates a quote.
+class VehicleCatalogRefresh {
+  VehicleCatalogRefresh(this.dio, {DateTime Function()? now})
+      : now = now ?? DateTime.now;
+
+  final Dio dio;
+  final DateTime Function() now;
+  String? _revision;
+  DateTime? _nextCheck;
+  Future<bool>? _inflight;
+
+  Future<bool> check() async {
+    if (_inflight != null) return _inflight!;
+    if (_nextCheck != null && now().isBefore(_nextCheck!)) return false;
+    final future = _fetch();
+    _inflight = future;
+    try {
+      return await future;
+    } finally {
+      _inflight = null;
+    }
+  }
+
+  Future<bool> _fetch() async {
+    // Failures/old servers also wait 5 minutes. No retries/request storm.
+    _nextCheck = now().add(const Duration(minutes: 5));
+    try {
+      final response = await dio
+          .get<dynamic>(
+        '/api/v1/vehicles/catalog/version',
+            options: Options(
+              headers: {if (_revision != null) 'If-None-Match': '"$_revision"'},
+              validateStatus: (status) => status == 200 || status == 304,
+              receiveTimeout: const Duration(seconds: 5),
+              sendTimeout: const Duration(seconds: 5),
+            ),
+          )
+          .timeout(const Duration(seconds: 6));
+      if (response.statusCode == 304) return false;
+      final data = response.data;
+      if (data is! Map ||
+          data['contract_version'] != 'catalog_v1' ||
+          data['complete'] != true ||
+          data['total'] is! int ||
+          (data['total'] as int) < 0) {
+        return false;
+      }
+      final revision = data['revision'];
+      if (revision is! String ||
+          !RegExp(r'^[a-f0-9]{64}$').hasMatch(revision)) {
+        return false;
+      }
+      if (revision == _revision) return false;
+      _revision = revision;
+      return true;
+    } catch (_) {
+      // Existing catalog TTL remains authoritative during an outage.
+      return false;
+    }
+  }
+}
