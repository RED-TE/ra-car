diff --git a/app/test/absolute_prepayment_evidence_test.dart b/app/test/absolute_prepayment_evidence_test.dart
new file mode 100644
--- /dev/null
+++ b/app/test/absolute_prepayment_evidence_test.dart
@@ -0,0 +1,260 @@
+// Explicit SYNTHETIC source/selection contracts. No HTTP or recorded prices.
+import 'package:flutter_test/flutter_test.dart';
+import 'package:recar_app/models/quote.dart';
+import 'package:recar_app/models/quote_selection.dart';
+import 'package:recar_app/services/quote_price_evidence.dart';
+
+import 'support/synthetic_selection_terms_estimate.dart';
+
+final _premium = QuoteSelection(vehicleTrimId: syntheticScopedTrim);
+final _withOptions = QuoteSelection(
+  vehicleTrimId: syntheticScopedTrim,
+  selectedOptionIds: const ['SYNTHETIC-OPTION-A', 'SYNTHETIC-OPTION-B'],
+  exteriorColorId: 'SYNTHETIC-EXTERIOR',
+  interiorColorId: 'SYNTHETIC-INTERIOR',
+);
+
+Map<String, dynamic> _data({
+  bool strict = false,
+  bool additiveScope = false,
+  int referencePrice = 45000000,
+  int selectedPrice = 50500000,
+  int amount = 13500000,
+  num sourcePct = 30,
+  QuoteSelection? selection,
+}) {
+  final selected = selection ?? _withOptions;
+  final data = syntheticSelectionTermsQuote();
+  data['normalized_selection'] = selected.toJson();
+  data['reference_vehicle_price'] = referencePrice;
+  data['selected_vehicle_price'] = selectedPrice;
+  data['vehicle_price'] = selectedPrice;
+  data['deposit'] = amount;
+  data['prepayment_pct'] = amount / selectedPrice * 100;
+  final proof = data['price_provenance'] as Map;
+  final market = proof['market_price'] as Map;
+  Map<String, dynamic> conditions() => {
+        'term_months': 60,
+        'annual_km': 10000,
+        'prepayment_pct': sourcePct,
+      };
+  market['applied_conditions'] = conditions();
+  market['source_points'] = <Map<String, dynamic>>[
+    {
+      'path': 'products.rent.conditionMonthly.60:${sourcePct.toInt()}:10000',
+      'role': 'BASE',
+      'conditions': conditions(),
+    },
+  ];
+  proof['unsupported_reasons'] = [
+    if (!strict) 'SOURCE_CONDITIONS_NOT_EXACTLY_VERIFIED',
+    if (amount > 0) 'NONZERO_PREPAYMENT_OUT_OF_INITIAL_SCOPE',
+    if (selected.selectedOptionIds.isNotEmpty) 'OPTIONS_OUT_OF_INITIAL_SCOPE',
+    if (selected.exteriorColorId != null || selected.interiorColorId != null)
+      'COLOR_OR_INVENTORY_OUT_OF_INITIAL_SCOPE',
+  ];
+  if (strict) {
+    proof['request_conditions_verified'] = true;
+    proof['sales_ai_eligible'] = (proof['unsupported_reasons'] as List).isEmpty;
+    market['unknown_reasons'] = <String>[];
+    market['match_status'] = 'EXACT';
+    data['condition_verified_monthly_payment'] = data['monthly_payment'];
+    if (!additiveScope) data.remove('selection_terms_estimate');
+  }
+  return data;
+}
+
+bool _validate(
+  Map<String, dynamic> data, {
+  int amount = 13500000,
+  int? inputPct,
+  int guarantee = 0,
+  bool allow = true,
+  QuoteSelection? selection,
+}) =>
+    QuotePriceEvidence.validate(
+      data,
+      vehicleId: syntheticScopedVehicle,
+      selection: selection ?? _withOptions,
+      productType: 'RENTAL',
+      term: 60,
+      mileageLimit: 10000,
+      deposit: amount,
+      guarantee: guarantee,
+      prepaymentPct: inputPct,
+      allowSelectionTermsEstimate: allow,
+    );
+
+Map _market(Map data) =>
+    (data['price_provenance'] as Map)['market_price'] as Map;
+Matcher get _rejected => throwsA(isA<QuoteConditionsUnverified>());
+
+void main() {
+  for (final strict in [false, true]) {
+    final path = strict ? 'strict' : 'scoped';
+    test('$path absolute KRW keeps premium trim and option/color amount', () {
+      for (final selectedPrice in [45000000, 48000000, 50500000]) {
+        final selection = selectedPrice == 50500000 ? _withOptions : _premium;
+        final data = _data(
+          strict: strict,
+          selectedPrice: selectedPrice,
+          selection: selection,
+        );
+        expect(_validate(data, selection: selection), strict);
+        expect(data['monthly_payment'], 277300);
+        expect(data['deposit'], 13500000);
+        expect(_market(data)['applied_conditions']['prepayment_pct'], 30);
+        final parsed = QuoteData.fromJson(
+          data,
+          preserveRequestPaymentUnits: true,
+          requestedPrepaymentPct: null,
+          strictPriceEvidenceAccepted: strict,
+        );
+        expect(parsed.prepaymentPct, isNull);
+        expect(parsed.deposit, 13500000);
+        expect(parsed.resolvedPrepaymentPct, 13500000 / selectedPrice * 100);
+        expect(parsed.isSelectionTermsEstimate, !strict);
+      }
+    });
+
+    test('$path percent and zero requests keep their existing basis', () {
+      final percent = _data(strict: strict, amount: 15150000);
+      percent['prepayment_pct'] = 30;
+      expect(_validate(percent, amount: 0, inputPct: 30), strict);
+      final zero = _data(strict: strict, amount: 0, sourcePct: 0);
+      expect(_validate(zero, amount: 0, inputPct: 0), strict);
+      expect(_validate(zero, amount: 0), strict);
+    });
+
+    for (final delta in [-1, 1]) {
+      test(
+        '$path rejects source/reference actual advance mismatch $delta KRW',
+        () {
+          final amount = 13500000 + delta;
+          final data = _data(strict: strict, amount: amount);
+          expect(() => _validate(data, amount: amount), _rejected);
+        },
+      );
+    }
+
+    for (final sample in [
+      (price: 45000005, expected: 4500000, wrong: 4500001),
+      (price: 45000015, expected: 4500002, wrong: 4500001),
+    ]) {
+      test('$path uses server half-even KRW at reference ${sample.price}', () {
+        final data = _data(
+          strict: strict,
+          referencePrice: sample.price,
+          amount: sample.expected,
+          sourcePct: 10,
+        );
+        expect(_validate(data, amount: sample.expected), strict);
+        final incorrect = _data(
+          strict: strict,
+          referencePrice: sample.price,
+          amount: sample.wrong,
+          sourcePct: 10,
+        );
+        expect(() => _validate(incorrect, amount: sample.wrong), _rejected);
+      });
+    }
+
+    final invalidReferences = <String, Object?>{
+      'missing': null,
+      'zero': 0,
+      'negative': -45000000,
+      'different': 50000000,
+      'string': '45000000',
+      'noninteger type': 45000000.0,
+      'boolean': true,
+      'nonfinite': double.nan,
+    };
+    for (final invalid in invalidReferences.entries) {
+      test('$path rejects ${invalid.key} source reference price', () {
+        final data = _data(strict: strict);
+        if (invalid.key == 'missing') {
+          data.remove('reference_vehicle_price');
+        } else {
+          data['reference_vehicle_price'] = invalid.value;
+        }
+        expect(() => _validate(data), _rejected);
+      });
+    }
+
+    final invalidPercents = <String, Object?>{
+      'missing': null,
+      'zero': 0,
+      'negative': -30,
+      'too large': 101,
+      'different': 20,
+      'string': '30',
+      'boolean': true,
+      'NaN': double.nan,
+      'infinity': double.infinity,
+      'negative infinity': double.negativeInfinity,
+    };
+    for (final invalid in invalidPercents.entries) {
+      test('$path rejects ${invalid.key} source percent', () {
+        final data = _data(strict: strict);
+        final applied = _market(data)['applied_conditions'] as Map;
+        if (invalid.key == 'missing') {
+          applied.remove('prepayment_pct');
+        } else {
+          applied['prepayment_pct'] = invalid.value;
+        }
+        expect(() => _validate(data), _rejected);
+      });
+    }
+
+    test(
+      '$path selected percent still must describe the actual selected KRW',
+      () {
+        final data = _data(strict: strict)..['prepayment_pct'] = 30;
+        expect(() => _validate(data), _rejected);
+      },
+    );
+
+    for (final attack in ['path', 'point percent', 'duplicate point']) {
+      test('$path rejects a forged direct-source $attack', () {
+        final data = _data(strict: strict);
+        final points = _market(data)['source_points'] as List;
+        if (attack == 'path') {
+          (points.single as Map)['path'] =
+              'products.rent.conditionMonthly.60:20:10000';
+        } else if (attack == 'point percent') {
+          ((points.single as Map)['conditions'] as Map)['prepayment_pct'] = 20;
+        } else {
+          points.add(Map<String, dynamic>.from(points.single as Map));
+        }
+        expect(() => _validate(data), _rejected);
+      });
+    }
+
+    test('$path still rejects an unknown/mismatched source', () {
+      final data = _data(strict: strict);
+      _market(data)['unknown_reasons'] = ['SOURCE_PREPAYMENT_AMOUNT_MISMATCH'];
+      _market(data)['match_status'] = 'UNKNOWN';
+      expect(() => _validate(data), _rejected);
+    });
+
+    test('$path still rejects nonzero requested or returned guarantee', () {
+      expect(() => _validate(_data(strict: strict), guarantee: 1), _rejected);
+      final data = _data(strict: strict)..['guarantee'] = 1;
+      expect(() => _validate(data), _rejected);
+    });
+  }
+
+  test(
+    'strict additive scope uses the source basis without implicit opt-in',
+    () {
+      final data = _data(strict: true, additiveScope: true);
+      expect(_validate(data, allow: false), isTrue);
+      (data['selection_terms_estimate'] as Map)['monthly_payment'] = 1;
+      expect(() => _validate(data, allow: false), _rejected);
+    },
+  );
+
+  test('absolute amount does not implicitly opt into scoped estimates', () {
+    expect(() => _validate(_data(), allow: false), _rejected);
+  });
+}
